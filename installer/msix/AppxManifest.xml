<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest template for the Microsoft Store build of PhoneDesk.

  scripts/package-msix.ps1 replaces the double-underscore placeholder tokens and runs
  makeappx.exe over the self-contained win-x64 publish output. The Store
  re-signs the package during publishing, so the package is uploaded unsigned.

  Identity Name and Publisher must match the values Partner Center shows under
  Product management > Product identity for the MSIX product. The defaults in
  scripts/package-msix.ps1 are development values for local sideload tests.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 uap10 desktop4 rescap">

  <Identity
    Name="__IDENTITY_NAME__"
    Publisher="__PUBLISHER__"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>__DISPLAY_NAME__</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>PhoneDesk for Microsoft Teams: guided setup and administration of auto attendants, call queues and resource accounts.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="de-de" />
  </Resources>

  <Applications>
    <Application Id="PhoneDesk" Executable="phonedesk.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="__DISPLAY_NAME__"
        Description="PhoneDesk for Microsoft Teams"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>

    <!--
      The MCP server for AI clients: a console program without a Start menu entry. A packaged
      executable cannot be started by its path from outside the package, so the alias puts
      "phonedesk-mcp.exe" on the user's PATH. A console alias needs an application that
      supports multiple instances, so the server is its own application and the desktop app
      keeps its activation behaviour.
    -->
    <Application
      Id="PhoneDeskMcp"
      Executable="phonedesk-mcp.exe"
      EntryPoint="Windows.FullTrustApplication"
      desktop4:Subsystem="console"
      desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="__DISPLAY_NAME__ MCP server"
        Description="PhoneDesk MCP server for AI clients"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <uap5:Extension
          Category="windows.appExecutionAlias"
          Executable="phonedesk-mcp.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="phonedesk-mcp.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
