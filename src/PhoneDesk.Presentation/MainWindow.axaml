<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:fi="using:FluentIcons.Avalonia"
        xmlns:fic="using:FluentIcons.Common"
        xmlns:local="clr-namespace:PhoneDesk"
        xmlns:viewmodels="clr-namespace:PhoneDesk.ViewModels"
        xmlns:converters="clr-namespace:PhoneDesk.Converters"
        xmlns:views="clr-namespace:PhoneDesk.Views"
        xmlns:services="clr-namespace:PhoneDesk.Services"
        xmlns:loc="clr-namespace:PhoneDesk.Localization"
        mc:Ignorable="d"
        x:Class="PhoneDesk.MainWindow"
        Title="PhoneDesk"
        Icon="avares://PhoneDesk.Presentation/Resources/app-icon.png"
        Width="1280"
        Height="720"
        MinWidth="1024"
        MinHeight="640"
        Background="{DynamicResource AppBackgroundBrush}">

    <!-- DataContext is set via DI in App.xaml.cs -->

    <Grid x:Name="MainGrid">

        <!-- ════════ Main layout: sidebar + content ════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="244"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Brand block -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="16,18,16,10">
                        <Border Width="38" Height="38"
                                CornerRadius="9"
                                BoxShadow="0 4 14 0 #405B5FC7"
                                VerticalAlignment="Top"
                                Margin="0,1,0,0">
                            <!-- The actual app icon, so branding matches the dock/taskbar/installer.
                                 CornerRadius mirrors the icon's own corner radius (38 * 230/1024). -->
                            <Image Source="avares://PhoneDesk.Presentation/Resources/app-icon.png"
                                   Width="38" Height="38"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="PhoneDesk"
                                       FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       LetterSpacing="-0.2"/>
                            <TextBlock Text="{loc:Translate Key=MainBrandForMicrosoftTeams}"
                                       FontFamily="{StaticResource DisplayFontFamily}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TeamsPrimaryBrush}"
                                       LetterSpacing="0.6"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0">
                                <TextBlock Text="{Binding Version}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Opacity="0.45"/>
                                <Button Content="{loc:Translate Key=MainUpdateBadge}"
                                        Command="{Binding ShowUpdateBannerCommand}"
                                        IsVisible="{Binding IsUpdateAvailable}"
                                        ToolTip.Tip="{Binding UpdateBannerMessage}"
                                        FontSize="9"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Background="{DynamicResource TeamsPrimaryBrush}"
                                        BorderThickness="0"
                                        CornerRadius="4"
                                        Padding="7,1"
                                        MinHeight="16"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Navigation -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="NavigationListBox" Classes="nav" Margin="10,0"
                                 SelectionChanged="NavigationListBox_SelectionChanged">

                            <ListBoxItem Classes="nav-header" IsEnabled="False" Focusable="False">
                                <TextBlock Text="{loc:Translate Key=MainNavigationGroupOverview}"/>
                            </ListBoxItem>

                            <ListBoxItem Tag="Welcome" Classes="nav" AutomationProperties.Name="{loc:Translate Key=MainNavigationWelcome}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                                    <fi:SymbolIcon Symbol="Home"/>
                                    <TextBlock Text="{loc:Translate Key=MainNavigationWelcome}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Tag="Dashboard" Classes="nav" AutomationProperties.Name="{loc:Translate Key=MainNavigationDashboard}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                                    <fi:SymbolIcon Symbol="DataTrending"/>
                                    <TextBlock Text="{loc:Translate Key=MainNavigationDashboard}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Tag="GetStarted" Classes="nav" AutomationProperties.Name="{loc:Translate Key=MainNavigationReadinessCheck}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                                    <fi:SymbolIcon Symbol="Rocket"/>
                                    <TextBlock Text="{loc:Translate Key=MainNavigationReadinessCheck}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Tag="Variables" Classes="nav" AutomationProperties.Name="{loc:Translate Key=MainNavigationConfiguration}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                                    <fi:SymbolIcon Symbol="Code"/>
                                    <TextBlock Text="{loc:Translate Key=MainNavigationConfiguration}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Classes="nav-header" IsEnabled="False" Focusable="False">
                                <TextBlock Text="{loc:Translate Key=MainNavigationGroupProvisioning}"/>
                            </ListBoxItem>

                            <ListBoxItem Tag="M365Groups" Classes="nav" AutomationProperties.Name="{loc:Translate Key=MainNavigationM365Groups}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                                    <fi:SymbolIcon Symbol="People"/>
                                    <TextBlock Text="{loc:Translate Key=MainNavigationM365Groups}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Tag="CallQueues" Classes="nav" AutomationProperties.Name="{loc:Translate Key=MainNavigationCallQueues}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                                    <fi:SymbolIcon Symbol="CallInbound"/>
                                    <TextBlock Text="{loc:Translate Key=MainNavigationCallQueues}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Tag="AutoAttendants" Classes="nav" AutomationProperties.Name="{loc:Translate Key=MainNavigationAutoAttendants}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                                    <fi:SymbolIcon Symbol="Bot"/>
                                    <TextBlock Text="{loc:Translate Key=MainNavigationAutoAttendants}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Tag="Holidays" Classes="nav" AutomationProperties.Name="{loc:Translate Key=MainNavigationHolidays}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                                    <fi:SymbolIcon Symbol="Calendar"/>
                                    <TextBlock Text="{loc:Translate Key=MainNavigationHolidays}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Classes="nav-header" IsEnabled="False" Focusable="False">
                                <TextBlock Text="{loc:Translate Key=MainNavigationGroupTools}"/>
                            </ListBoxItem>

                            <ListBoxItem Tag="Wizard" Classes="nav" AutomationProperties.Name="{loc:Translate Key=MainNavigationGuidedSetup}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                                    <fi:SymbolIcon Symbol="Wand"/>
                                    <TextBlock Text="{loc:Translate Key=MainNavigationGuidedSetup}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Tag="BulkOperations" Classes="nav" AutomationProperties.Name="{loc:Translate Key=MainNavigationBulkOperations}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                                    <fi:SymbolIcon Symbol="TableMultiple"/>
                                    <TextBlock Text="{loc:Translate Key=MainNavigationBulkOperations}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Tag="Documentation" Classes="nav" AutomationProperties.Name="{loc:Translate Key=MainNavigationTenantReport}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                                    <fi:SymbolIcon Symbol="DocumentText"/>
                                    <TextBlock Text="{loc:Translate Key=MainNavigationTenantReport}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>

                            <ListBoxItem Tag="History" Classes="nav" AutomationProperties.Name="{loc:Translate Key=MainNavigationAuditLog}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                                    <fi:SymbolIcon Symbol="History"/>
                                    <TextBlock Text="{loc:Translate Key=MainNavigationAuditLog}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </ScrollViewer>

                    <!-- Sidebar footer: connection state + settings -->
                    <StackPanel Grid.Row="2" Margin="14,10,14,14" Spacing="10">
                        <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="-4,0"/>
                        <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding ConnectionStatusText}">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Border Classes="chip" Classes.ok="{Binding IsTeamsConnected}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Classes="status-dot" Fill="{DynamicResource StatusOnBrush}"
                                                 IsVisible="{Binding IsTeamsConnected}"/>
                                        <Ellipse Classes="status-dot" Fill="{DynamicResource StatusOffBrush}"
                                                 IsVisible="{Binding !IsTeamsConnected}"/>
                                        <TextBlock Text="{loc:Translate Key=MainConnectionTeams}" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                                <Border Classes="chip" Classes.ok="{Binding IsGraphConnected}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Classes="status-dot" Fill="{DynamicResource StatusOnBrush}"
                                                 IsVisible="{Binding IsGraphConnected}"/>
                                        <Ellipse Classes="status-dot" Fill="{DynamicResource StatusOffBrush}"
                                                 IsVisible="{Binding !IsGraphConnected}"/>
                                        <TextBlock Text="{loc:Translate Key=MainConnectionGraph}" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Button x:Name="SettingsButton"
                                    Grid.Column="1"
                                    Command="{Binding ToggleSettingsCommand}"
                                    Width="32"
                                    Height="32"
                                    Margin="6,0,0,0"
                                    Classes="IconOnly"
                                    AutomationProperties.Name="{loc:Translate Key=MainSettingsButton}"
                                    ToolTip.Tip="{loc:Translate Key=MainSettingsButton}">
                                <fi:SymbolIcon Symbol="Settings" FontSize="16"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content column -->
            <Grid Grid.Column="1" RowDefinitions="*,Auto">

                <!-- Content Area -->
                <Grid Grid.Row="0" Margin="20,18,20,10">
                    <TransitioningContentControl Content="{Binding CurrentViewModel}">
                        <TransitioningContentControl.PageTransition>
                            <CrossFade Duration="0:0:0.15"/>
                        </TransitioningContentControl.PageTransition>
                    </TransitioningContentControl>
                </Grid>

                <!-- Status Bar -->
                <Border Grid.Row="1"
                        Background="Transparent"
                        BorderBrush="{DynamicResource HairlineBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="20,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Latest Log Entry - Clickable Log Area -->
                        <Button Grid.Column="0"
                                Command="{Binding ToggleLogDialogCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8,5"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                ToolTip.Tip="{loc:Translate Key=MainLatestLogTooltip}"
                                AutomationProperties.Name="{loc:Translate Key=MainLatestLogAutomationName}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <fi:SymbolIcon Grid.Column="0"
                                          FontSize="14"
                                          Symbol="Code"
                                          Foreground="{DynamicResource TeamsPrimaryBrush}"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                         Text="{Binding LatestLogEntry}"
                                         TextTrimming="CharacterEllipsis"
                                         VerticalAlignment="Center"
                                         Classes="code"
                                         FontSize="11"
                                         Opacity="0.85"/>
                                <fi:SymbolIcon Grid.Column="2"
                                          FontSize="13"
                                          Symbol="ChevronRight"
                                          Margin="8,0,0,0"
                                          Opacity="0.5"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Copyright -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Copyright}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   Opacity="0.5"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Log Viewer Dialog - Border overlay -->
        <Border IsVisible="{Binding IsLogDialogOpen}"
                Background="#8C0A0A14"
                ZIndex="1000"
                PointerPressed="LogDialogBackdrop_PointerPressed">
            <Border.Styles>
                <Style Selector="Border">
                    <Style.Animations>
                        <Animation Duration="0:0:0.2">
                            <KeyFrame Cue="0%">
                                <Setter Property="Opacity" Value="0"/>
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="Opacity" Value="1"/>
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Border.Styles>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                  PointerPressed="LogDialogCard_PointerPressed">
                <Border Classes="dialog"
                        Margin="16" MaxWidth="1000" MaxHeight="600" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Dialog Header -->
                        <Border Grid.Row="0"
                                BorderBrush="{DynamicResource HairlineBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="20,12">
                            <DockPanel LastChildFill="False">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <fi:SymbolIcon Symbol="Code" Foreground="{DynamicResource TeamsPrimaryBrush}"/>
                                    <TextBlock Text="{loc:Translate Key=MainLogViewerTitle}"
                                             FontFamily="{StaticResource DisplayFontFamily}"
                                             FontWeight="SemiBold"
                                             VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right"
                                        Command="{Binding CloseLogDialogCommand}"
                                        Width="36"
                                        Height="36"
                                        Classes="IconOnly"
                                        AutomationProperties.Name="{loc:Translate Key=MainLogViewerCloseAutomationName}"
                                        ToolTip.Tip="{loc:Translate Key=CommonClose}">
                                    <fi:SymbolIcon Symbol="Dismiss"/>
                                </Button>
                            </DockPanel>
                        </Border>
                        <!-- Log Content -->
                        <Border Grid.Row="1" Classes="sunken" Margin="16">
                            <ScrollViewer x:Name="LogScrollViewer"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Auto">
                                <TextBox x:Name="LogView"
                                       Text="{Binding AllLogEntriesText, Mode=OneWay}"
                                       TextWrapping="NoWrap"
                                       Classes="code"
                                       IsReadOnly="True"
                                       AcceptsReturn="True"
                                       AcceptsTab="True"
                                       BorderThickness="0"
                                       Background="Transparent"
                                       Padding="12"
                                       VerticalContentAlignment="Top"
                                       TextChanged="LogView_TextChanged">
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:Translate Key=MainLogClear}"
                                                    Command="{Binding ClearLogCommand}"/>
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>
                            </ScrollViewer>
                        </Border>
                        <!-- Dialog Footer -->
                        <StackPanel Grid.Row="2"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Right"
                                   Margin="16,0,16,16"
                                   Spacing="12">
                            <Button Command="{Binding ClearLogCommand}"
                                    Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon FontSize="16" Symbol="Delete"/>
                                    <TextBlock Text="{loc:Translate Key=MainLogClear}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CloseLogDialogCommand}"
                                    Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon FontSize="16" Symbol="Dismiss"/>
                                    <TextBlock Text="{loc:Translate Key=CommonClose}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Settings Side Panel -->
        <!-- Overlay backdrop -->
        <Border Background="#8C0A0A14"
                IsVisible="{Binding IsSettingsOpen}"
                ZIndex="1000"
                PointerPressed="SettingsOverlay_PointerPressed">
            <Border.Styles>
                <Style Selector="Border">
                    <Style.Animations>
                        <Animation Duration="0:0:0.2">
                            <KeyFrame Cue="0%">
                                <Setter Property="Opacity" Value="0"/>
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="Opacity" Value="1"/>
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Border.Styles>
        </Border>
        <!-- Side panel -->
        <Border Background="{DynamicResource SurfaceDialogBrush}"
                Width="400"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                IsVisible="{Binding IsSettingsOpen}"
                ZIndex="1001"
                ClipToBounds="True"
                BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="1,0,0,0"
                BoxShadow="-8 0 32 0 #50000000">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Header -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource HairlineBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="24,16">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <fi:SymbolIcon Symbol="Settings" Foreground="{DynamicResource TeamsPrimaryBrush}"/>
                            <TextBlock Text="{loc:Translate Key=SettingsTitle}"
                                     FontFamily="{StaticResource DisplayFontFamily}"
                                     FontSize="17"
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Command="{Binding CloseSettingsCommand}"
                                Width="36"
                                Height="36"
                                Classes="IconOnly"
                                AutomationProperties.Name="{loc:Translate Key=SettingsCloseAutomationName}"
                                ToolTip.Tip="{loc:Translate Key=CommonClose}">
                            <fi:SymbolIcon Symbol="Dismiss"/>
                        </Button>
                    </DockPanel>
                </Border>
                <!-- Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20" Spacing="20">

                        <!-- Appearance Section -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="{loc:Translate Key=SettingsAppearanceSection}"
                                     FontSize="16"
                                     FontWeight="SemiBold"/>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <TextBlock Grid.Column="0"
                                         Text="{loc:Translate Key=SettingsDarkTheme}"
                                         VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="1"
                                            IsChecked="{Binding IsDarkTheme}"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource HairlineBrush}"/>

                        <StackPanel Spacing="12">
                            <TextBlock Text="{loc:Translate Key=SettingsLanguageSectionTitle}"
                                     FontSize="16"
                                     FontWeight="SemiBold"/>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <TextBlock Grid.Column="0"
                                         Text="{loc:Translate Key=SettingsLanguageLabel}"
                                         VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding LanguageOptions}"
                                          SelectedValueBinding="{Binding Language}"
                                          SelectedValue="{Binding CurrentLanguage}"
                                          MinWidth="140"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource HairlineBrush}"/>

                        <!-- Workflow Section -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="{loc:Translate Key=SettingsWorkflowSection}"
                                     FontSize="16"
                                     FontWeight="SemiBold"/>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Translate Key=SettingsSkipScriptPreviewTitle}"/>
                                    <TextBlock Text="{loc:Translate Key=SettingsSkipScriptPreviewDescription}"
                                             FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                            IsChecked="{Binding SkipScriptPreview}"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Translate Key=SettingsSkipDeleteConfirmationTitle}"/>
                                    <TextBlock Text="{loc:Translate Key=SettingsSkipDeleteConfirmationDescription}"
                                             FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                            IsChecked="{Binding SkipDeleteConfirmation}"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Translate Key=SettingsAutoRefreshAfterOperationsTitle}"/>
                                    <TextBlock Text="{loc:Translate Key=SettingsAutoRefreshAfterOperationsDescription}"
                                             FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                            IsChecked="{Binding AutoRefreshAfterOperations}"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource HairlineBrush}"/>

                        <!-- Logging Section -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="{loc:Translate Key=SettingsLoggingSection}"
                                     FontSize="16"
                                     FontWeight="SemiBold"/>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Translate Key=SettingsMinimumLogLevelTitle}"/>
                                    <TextBlock Text="{loc:Translate Key=SettingsMinimumLogLevelDescription}"
                                             FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                        SelectedIndex="{Binding SelectedLogLevelIndex}"
                                        MinWidth="110"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                    <ComboBoxItem Content="{loc:Translate Key=SettingsLogLevelInfo}"/>
                                    <ComboBoxItem Content="{loc:Translate Key=SettingsLogLevelSuccess}"/>
                                    <ComboBoxItem Content="{loc:Translate Key=SettingsLogLevelWarning}"/>
                                    <ComboBoxItem Content="{loc:Translate Key=SettingsLogLevelError}"/>
                                </ComboBox>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Translate Key=SettingsAuditLogLocationTitle}"/>
                                    <TextBlock Text="{Binding AuditLogDirectory}"
                                             FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding OpenAuditFolderCommand}"
                                        Classes="IconText"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{loc:Translate Key=SettingsOpenAuditLogFolderTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <fi:SymbolIcon Symbol="FolderOpen"/>
                                        <TextBlock Text="{loc:Translate Key=MainActionOpenAuditLogFolder}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource HairlineBrush}"/>

                        <!-- About Section -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="{loc:Translate Key=SettingsAboutSection}"
                                     FontSize="16"
                                     FontWeight="SemiBold"/>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Translate Key=SettingsMicrosoftTeamsModuleTitle}"/>
                                    <TextBlock Text="{loc:Translate Key=SettingsBundledPowerShellModuleDescription}"
                                             FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                         Text="{Binding BundledTeamsModuleVersion}"
                                         Margin="12,0,0,0"
                                         VerticalAlignment="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Translate Key=SettingsMicrosoftGraphModulesTitle}"/>
                                    <TextBlock Text="{loc:Translate Key=SettingsBundledPowerShellModuleDescription}"
                                             FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                         Text="{Binding BundledGraphModuleVersion}"
                                         Margin="12,0,0,0"
                                         VerticalAlignment="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Translate Key=SettingsPowerShellSdkTitle}"/>
                                    <TextBlock Text="{loc:Translate Key=SettingsBundledPowerShellRuntimeDescription}"
                                             FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                         Text="{Binding BundledPowerShellSdkVersion}"
                                         Margin="12,0,0,0"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Update notification banner (top overlay, dismissible) -->
        <ui:InfoBar Grid.Column="0" Grid.ColumnSpan="2"
                    Title="{loc:Translate Key=UpdateAvailableTitle}"
                    Message="{Binding UpdateBannerMessage}"
                    IsOpen="{Binding IsUpdateBannerVisible, Mode=TwoWay}"
                    Severity="Informational"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    MinWidth="420"
                    Margin="0,8,0,0">
            <ui:InfoBar.ActionButton>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Translate Key=UpdateInstallAction}"
                            Command="{Binding InstallUpdateCommand}"
                            IsVisible="{Binding CanInstallUpdate}"/>
                    <Button Content="{loc:Translate Key=UpdateCancelAction}"
                            Command="{Binding CancelUpdateCommand}"
                            IsVisible="{Binding IsUpdateInProgress}"/>
                    <Button Content="{loc:Translate Key=UpdateViewReleaseAction}" Command="{Binding OpenUpdatePageCommand}"/>
                </StackPanel>
            </ui:InfoBar.ActionButton>
            <ProgressBar Width="360"
                         Margin="0,8,0,0"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding UpdateDownloadProgress}"
                         IsIndeterminate="{Binding IsUpdateProgressIndeterminate}"
                         IsVisible="{Binding IsUpdateInProgress}"/>
        </ui:InfoBar>
    </Grid>
</Window>
