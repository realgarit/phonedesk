<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:fic="using:FluentIcons.Common"
             xmlns:loc="clr-namespace:PhoneDesk.Localization"
             xmlns:local="clr-namespace:PhoneDesk.Views"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:viewmodels="clr-namespace:PhoneDesk.ViewModels"
             xmlns:converters="clr-namespace:PhoneDesk.Converters"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="PhoneDesk.Views.AutoAttendantsView"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <!-- DataContext is set via data binding from MainWindow -->

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Ellipsis-trim long values in list grids so rows stay distinguishable and the
             rightmost column's text can never disappear under the vertical scrollbar. -->
        <Style Selector="DataGridCell TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Styles>

    <Grid>
    <Border Classes="card" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Main Content -->
            <Grid Grid.Row="0" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Page Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Classes="icon-badge">
                        <fi:SymbolIcon Symbol="Bot"/>
                    </Border>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Translate Key=MainNavigationAutoAttendants}" Classes="page-title" Margin="0"/>
                        <TextBlock Text="{loc:Translate Key=AutoAttendantsSubtitle}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
                </StackPanel>

                <!-- Status Message -->
                <ui:InfoBar Grid.Row="1"
                           Title="{Binding StatusMessage}"
                           IsOpen="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           IsClosable="True"
                           Margin="0,0,0,12"/>

                <!-- Tab Control -->
                <TabControl Grid.Row="2" >
                    <!-- Resource Accounts Tab -->
                    <TabItem Header="{loc:Translate Key=CommonResourceAccountsTab}">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Resource Accounts Actions -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{Binding RetrieveResourceAccountsCommand}"
                                        Margin="0,0,16,0" Classes="IconText">
                                    <StackPanel Orientation="Horizontal">
                                        <fi:SymbolIcon  Symbol="ArrowSync"/>
                                        <TextBlock Text="{loc:Translate Key=ProvisioningLoadResourceAccountsAction}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1"
                                        Command="{Binding OpenCreateResourceAccountDialogCommand}"
                                        Margin="0,0,8,0" Classes="IconText">
                                    <StackPanel Orientation="Horizontal">
                                        <fi:SymbolIcon  Symbol="PersonAdd"/>
                                        <TextBlock Text="{loc:Translate Key=ProvisioningCreateResourceAccountAction}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Command="{Binding RemoveResourceAccountCommand}"
                                        ToolTip.Tip="{loc:Translate Key=ProvisioningDeleteResourceAccountTooltip}"
                                        Margin="0,0,16,0" Classes="IconText">
                                    <StackPanel Orientation="Horizontal">
                                        <fi:SymbolIcon Symbol="PersonDelete" Foreground="OrangeRed"/>
                                        <TextBlock Text="{loc:Translate Key=ProvisioningDeleteResourceAccountAction}" VerticalAlignment="Center" Foreground="OrangeRed"/>
                                    </StackPanel>
                                </Button>

                                <TextBox Grid.Column="3"
                                         Text="{Binding SearchResourceAccountsText}"
                                         Watermark="{loc:Translate Key=ProvisioningSearchResourceAccountsWatermark}"
                                         ToolTip.Tip="{loc:Translate Key=ProvisioningSearchResourceAccountsTooltip}"
                                         AutomationProperties.Name="{loc:Translate Key=ProvisioningSearchResourceAccountsAutomationName}"/>
                            </Grid>

                            <!-- Resource Accounts List -->
                            <Grid Grid.Row="2">
                                <DataGrid AutomationProperties.Name="{loc:Translate Key=ProvisioningResourceAccountsGridAutomationName}"
                                          ItemsSource="{Binding ResourceAccountsView}"
                                          AutoGenerateColumns="False"
                                          HeadersVisibility="Column"
                                          IsReadOnly="True"
                                          GridLinesVisibility="None"
                                          SelectionMode="Single"
                                          HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Translate Key=CommonDisplayNameColumn}" Binding="{Binding DisplayName}" Width="2*"/>
                                        <DataGridTextColumn Header="{loc:Translate Key=CommonUpnColumn}" Binding="{Binding UserPrincipalName}" Width="2*"/>
                                        <DataGridTextColumn Header="{loc:Translate Key=CommonIdentityColumn}" Binding="{Binding Identity}" Width="2*"/>
                                        <DataGridTextColumn Header="{loc:Translate Key=CommonUsageLocationColumn}" Binding="{Binding UsageLocation}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsVisible="{Binding !ResourceAccountsView.Count}"
                                            Opacity="0.85" Spacing="10">
                                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                                        <fi:SymbolIcon Symbol="PersonSearch" IsFilled="True" FontSize="26" Foreground="{DynamicResource TeamsPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                                    </Border>
                                    <TextBlock Text="{loc:Translate Key=ProvisioningNoResourceAccountsLoadedTitle}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{loc:Translate Key=ProvisioningNoResourceAccountsLoadedDescription}" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Auto Attendants Tab -->
                    <TabItem Header="{loc:Translate Key=MainNavigationAutoAttendants}">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Auto Attendants Actions -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{Binding RetrieveAutoAttendantsCommand}"
                                        Margin="0,0,16,0" Classes="IconText">
                                    <StackPanel Orientation="Horizontal">
                                        <fi:SymbolIcon  Symbol="ArrowSync"/>
                                        <TextBlock Text="{loc:Translate Key=AutoAttendantsLoadAction}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1"
                                        Command="{Binding OpenCreateAutoAttendantDialogCommand}"
                                        Margin="0,0,8,0" Classes="IconText">
                                    <StackPanel Orientation="Horizontal">
                                        <fi:SymbolIcon  Symbol="CallInbound"/>
                                        <TextBlock Text="{loc:Translate Key=AutoAttendantsCreateAction}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Command="{Binding RemoveAutoAttendantCommand}"
                                        ToolTip.Tip="{loc:Translate Key=AutoAttendantsDeleteTooltip}"
                                        Margin="0,0,16,0" Classes="IconText">
                                    <StackPanel Orientation="Horizontal">
                                        <fi:SymbolIcon Symbol="Delete" Foreground="OrangeRed"/>
                                        <TextBlock Text="{loc:Translate Key=AutoAttendantsDeleteAction}" VerticalAlignment="Center" Foreground="OrangeRed"/>
                                    </StackPanel>
                                </Button>

                                <TextBox Grid.Column="3"
                                         Text="{Binding SearchAutoAttendantsText}"
                                         Watermark="{loc:Translate Key=AutoAttendantsSearchWatermark}"
                                         ToolTip.Tip="{loc:Translate Key=AutoAttendantsSearchTooltip}"
                                         AutomationProperties.Name="{loc:Translate Key=AutoAttendantsSearchAutomationName}"/>
                            </Grid>

                            <!-- Auto Attendants List -->
                            <Grid Grid.Row="2">
                            <DataGrid AutomationProperties.Name="{loc:Translate Key=AutoAttendantsGridAutomationName}"
                                      ItemsSource="{Binding AutoAttendantsView}"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      IsReadOnly="True"
                                      GridLinesVisibility="None"
                                      SelectionMode="Single"
                                      HorizontalScrollBarVisibility="Auto"
                                      >
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Translate Key=CommonNameColumn}" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="{loc:Translate Key=CommonIdentityColumn}" Binding="{Binding Identity}" Width="2*"/>
                                    <DataGridTextColumn Header="{loc:Translate Key=CommonLanguageIdColumn}" Binding="{Binding LanguageId}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Translate Key=CommonTimeZoneIdColumn}" Binding="{Binding TimeZoneId}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsVisible="{Binding !AutoAttendantsView.Count}"
                                        Opacity="0.85" Spacing="10">
                                <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                                        <fi:SymbolIcon Symbol="Bot" IsFilled="True" FontSize="26" Foreground="{DynamicResource TeamsPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                                    </Border>
                                <TextBlock Text="{loc:Translate Key=AutoAttendantsEmptyTitle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:Translate Key=AutoAttendantsEmptyDescription}" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Step-by-Step Creation Tab -->
                    <TabItem Header="{loc:Translate Key=MainNavigationGuidedSetup}">
                        <ScrollViewer Margin="16">
                            <StackPanel>
                                <TextBlock Text="{loc:Translate Key=AutoAttendantsGuidedSetupIntro}"
                                         FontSize="18"
                                 FontWeight="SemiBold"
                                         Margin="0,0,0,24"/>

                                <!-- Step 1: Create Resource Account -->
                                <Border Classes="card interactive" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=AutoAttendantsStep1Title}"
                                                 FontSize="18"
                                                 FontWeight="Bold"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="{loc:Translate Key=AutoAttendantsStep1Description}"
                                                 FontSize="14"
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,0,16"/>
                                        <Button
                                                Command="{Binding OpenCreateResourceAccountDialogCommand}"
                                                HorizontalAlignment="Left" Classes="IconText">
                                            <StackPanel Orientation="Horizontal">
                                                <fi:SymbolIcon  Symbol="PersonAdd"/>
                                                <TextBlock Text="{loc:Translate Key=ProvisioningCreateResourceAccountAction}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Step 2: Update Usage Location -->
                                <Border Classes="card interactive" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=ProvisioningStep2Title}"
                                                 FontSize="18"
                                                 FontWeight="Bold"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="{loc:Translate Key=ProvisioningStep2Description}"
                                                 FontSize="14"
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,0,16"/>
                                        <Button
                                                Command="{Binding OpenUpdateUsageLocationDialogCommand}"
                                                HorizontalAlignment="Left" Classes="IconText">
                                            <StackPanel Orientation="Horizontal">
                                                <fi:SymbolIcon  Symbol="Location"/>
                                                <TextBlock Text="{loc:Translate Key=ProvisioningUpdateUsageLocationAction}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Step 3: Assign License -->
                                <Border Classes="card interactive" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=ProvisioningStep3Title}"
                                                 FontSize="18"
                                                 FontWeight="Bold"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="{loc:Translate Key=ProvisioningStep3Description}"
                                                 FontSize="14"
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,0,16"/>
                                        <Button
                                                Command="{Binding AssignLicenseCommand}"
                                                HorizontalAlignment="Left" Classes="IconText">
                                            <StackPanel Orientation="Horizontal">
                                                <fi:SymbolIcon  Symbol="Certificate"/>
                                                <TextBlock Text="{loc:Translate Key=ProvisioningAssignLicenseAction}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Step 4: Validate Call Queue Resource Account -->
                                <Border Classes="card interactive" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=AutoAttendantsStep4Title}"
                                                 FontSize="18"
                                                 FontWeight="Bold"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="{loc:Translate Key=AutoAttendantsStep4Description}"
                                                 FontSize="14"
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,0,16"/>
                                        <Button
                                                Command="{Binding OpenValidateCallQueueDialogCommand}"
                                                HorizontalAlignment="Left" Classes="IconText">
                                            <StackPanel Orientation="Horizontal">
                                                <fi:SymbolIcon  Symbol="Person"/>
                                                <TextBlock Text="{loc:Translate Key=AutoAttendantsValidateCallQueueAccountAction}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Step 5: Create Call Target -->
                                <Border Classes="card interactive" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=AutoAttendantsStep5Title}"
                                                 FontSize="18"
                                                 FontWeight="Bold"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="{loc:Translate Key=AutoAttendantsStep5Description}"
                                                 FontSize="14"
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,0,16"/>
                                        <Button
                                                Command="{Binding OpenCreateCallTargetDialogCommand}"
                                                HorizontalAlignment="Left" Classes="IconText">
                                            <StackPanel Orientation="Horizontal">
                                                <fi:SymbolIcon  Symbol="PersonArrowRight"/>
                                                <TextBlock Text="{loc:Translate Key=AutoAttendantsCreateForwardingTargetAction}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Step 6: Create Default Call Flow -->
                                <Border Classes="card interactive" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=AutoAttendantsStep6Title}"
                                                 FontSize="18"
                                                 FontWeight="Bold"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="{loc:Translate Key=AutoAttendantsStep6Description}"
                                                 FontSize="14"
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,0,16"/>
                                        <Button
                                                Command="{Binding OpenCreateDefaultCallFlowDialogCommand}"
                                                HorizontalAlignment="Left" Classes="IconText">
                                            <StackPanel Orientation="Horizontal">
                                                <fi:SymbolIcon  Symbol="CallForward"/>
                                                <TextBlock Text="{loc:Translate Key=AutoAttendantsCreateDefaultCallFlowAction}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Step 7: Create After Hours Call Flow -->
                                <Border Classes="card interactive" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=AutoAttendantsStep7Title}"
                                                 FontSize="18"
                                                 FontWeight="Bold"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="{loc:Translate Key=AutoAttendantsStep7Description}"
                                                 FontSize="14"
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,0,16"/>
                                        <Button
                                                Command="{Binding OpenCreateAfterHoursCallFlowDialogCommand}"
                                                HorizontalAlignment="Left" Classes="IconText">
                                            <StackPanel Orientation="Horizontal">
                                                <fi:SymbolIcon  Symbol="CallEnd"/>
                                                <TextBlock Text="{loc:Translate Key=AutoAttendantsCreateAfterHoursCallFlowAction}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Step 8: Create After Hours Schedule -->
                                <Border Classes="card interactive" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=AutoAttendantsStep8Title}"
                                                 FontSize="18"
                                                 FontWeight="Bold"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="{loc:Translate Key=AutoAttendantsStep8Description}"
                                                 FontSize="14"
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,0,16"/>
                                        <Button
                                                Command="{Binding OpenCreateAfterHoursScheduleDialogCommand}"
                                                HorizontalAlignment="Left" Classes="IconText">
                                            <StackPanel Orientation="Horizontal">
                                                <fi:SymbolIcon  Symbol="Clock"/>
                                                <TextBlock Text="{loc:Translate Key=AutoAttendantsCreateAfterHoursScheduleAction}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Step 9: Create Call Handling Association -->
                                <Border Classes="card interactive" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=AutoAttendantsStep9Title}"
                                                 FontSize="18"
                                                 FontWeight="Bold"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="{loc:Translate Key=AutoAttendantsStep9Description}"
                                                 FontSize="14"
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,0,16"/>
                                        <Button
                                                Command="{Binding OpenCreateCallHandlingAssociationDialogCommand}"
                                                HorizontalAlignment="Left" Classes="IconText">
                                            <StackPanel Orientation="Horizontal">
                                                <fi:SymbolIcon  Symbol="Link"/>
                                                <TextBlock Text="{loc:Translate Key=AutoAttendantsLinkScheduleToCallFlowAction}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Step 10: Create Auto Attendant -->
                                <Border Classes="card interactive" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=AutoAttendantsStep10Title}"
                                                 FontSize="18"
                                                 FontWeight="Bold"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="{loc:Translate Key=AutoAttendantsStep10Description}"
                                                 FontSize="14"
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,0,16"/>
                                        <Button
                                                Command="{Binding OpenCreateAutoAttendantDialogCommand}"
                                                HorizontalAlignment="Left" Classes="IconText">
                                            <StackPanel Orientation="Horizontal">
                                                <fi:SymbolIcon  Symbol="CallInbound"/>
                                                <TextBlock Text="{loc:Translate Key=AutoAttendantsCreateAction}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Step 11: Associate Resource Account -->
                                <Border Classes="card interactive" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=AutoAttendantsStep11Title}"
                                                 FontSize="18"
                                                 FontWeight="Bold"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="{loc:Translate Key=AutoAttendantsStep11Description}"
                                                 FontSize="14"
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,0,16"/>
                                        <Button
                                                Command="{Binding OpenAssociateDialogCommand}"
                                                HorizontalAlignment="Left" Classes="IconText">
                                            <StackPanel Orientation="Horizontal">
                                                <fi:SymbolIcon  Symbol="Link"/>
                                                <TextBlock Text="{loc:Translate Key=AutoAttendantsAssignResourceAccountAction}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Progress Bar -->
            <ProgressBar Grid.Row="1" 
                         IsIndeterminate="{Binding IsBusy}"
                         IsVisible="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Height="4"
                         Margin="32,0,32,16"/>
        </Grid>
    </Border>

            <!-- Create Resource Account Dialog - Border overlay -->
            <Border IsVisible="{Binding ShowCreateResourceAccountDialog}"
                    Background="#80000000"
                    ZIndex="1000"
                    PointerPressed="CreateResourceAccountBackdrop_PointerPressed">
                <Border.Styles>
                    <Style Selector="Border">
                        <Style.Animations>
                            <Animation Duration="0:0:0.2">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Border.Styles>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      PointerPressed="CreateResourceAccountCard_PointerPressed">
                    <Border Classes="dialog" MinWidth="400" Margin="16">
                        <StackPanel>
                        <TextBlock Text="{loc:Translate Key=ProvisioningCreateResourceAccountTitle}"
                                 Classes="dialog-title"/>
                        <TextBlock Text="{loc:Translate Key=CommonUpnLabel}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,8"/>
                        <TextBox Text="{Binding ResourceAccountUpn}"
                               Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Translate Key=CommonDisplayNameLabel}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,8"/>
                        <TextBox Text="{Binding ResourceAccountDisplayName}"
                               Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Translate Key=ProvisioningCreateResourceAccountDescription}"
                                 FontSize="12"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Right"
                                  Spacing="16">
                            <Button Command="{Binding CloseCreateResourceAccountDialogCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Dismiss"/>
                                    <TextBlock Text="{loc:Translate Key=CommonCancel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                    Command="{Binding CreateResourceAccountCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon  Symbol="PersonAdd"/>
                                    <TextBlock Text="{loc:Translate Key=ProvisioningCreateResourceAccountAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Update Usage Location Dialog - Border overlay -->
            <Border IsVisible="{Binding ShowUpdateUsageLocationDialog}"
                    Background="#80000000"
                    ZIndex="1000"
                    PointerPressed="UpdateUsageLocationBackdrop_PointerPressed">
                <Border.Styles>
                    <Style Selector="Border">
                        <Style.Animations>
                            <Animation Duration="0:0:0.2">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Border.Styles>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      PointerPressed="UpdateUsageLocationCard_PointerPressed">
                    <Border Classes="dialog" MinWidth="400" Margin="16">
                        <StackPanel>
                        <TextBlock Text="{loc:Translate Key=ProvisioningUpdateUsageLocationTitle}"
                                 Classes="dialog-title"/>
                        <TextBlock Text="{loc:Translate Key=CommonResourceAccountUpnLabel}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,8"/>
                        <TextBox Text="{Binding ResourceAccountUpn}"
                               IsReadOnly="True"
                               Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Translate Key=ProvisioningUpdateUsageLocationDescription}"
                                 FontSize="12"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Right"
                                  Spacing="16">
                            <Button Command="{Binding CloseUpdateUsageLocationDialogCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Dismiss"/>
                                    <TextBlock Text="{loc:Translate Key=CommonCancel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                    Command="{Binding UpdateUsageLocationCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon  Symbol="Location"/>
                                    <TextBlock Text="{loc:Translate Key=ProvisioningUpdateUsageLocationAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Create Auto Attendant Dialog - Border overlay -->
            <Border IsVisible="{Binding ShowCreateAutoAttendantDialog}"
                    Background="#80000000"
                    ZIndex="1000"
                    PointerPressed="CreateAutoAttendantBackdrop_PointerPressed">
                <Border.Styles>
                    <Style Selector="Border">
                        <Style.Animations>
                            <Animation Duration="0:0:0.2">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Border.Styles>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      PointerPressed="CreateAutoAttendantCard_PointerPressed">
                    <Border Classes="dialog" MinWidth="400" Margin="16">
                        <StackPanel>
                        <TextBlock Text="{loc:Translate Key=AutoAttendantsCreateDialogTitle}"
                                 Classes="dialog-title"/>
                        <TextBlock Text="{loc:Translate Key=CommonAutoAttendantNameLabel}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,8"/>
                        <TextBox Text="{Binding AutoAttendantName}"
                               Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Translate Key=AutoAttendantsCreateDialogDescription}"
                                 FontSize="12"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Right"
                                  Spacing="16">
                            <Button Command="{Binding CloseCreateAutoAttendantDialogCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Dismiss"/>
                                    <TextBlock Text="{loc:Translate Key=CommonCancel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                    Command="{Binding CreateAutoAttendantCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon  Symbol="CallInbound"/>
                                    <TextBlock Text="{loc:Translate Key=AutoAttendantsCreateAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Associate Resource Account Dialog - Border overlay -->
            <Border IsVisible="{Binding ShowAssociateDialog}"
                    Background="#80000000"
                    ZIndex="1000"
                    PointerPressed="AssociateResourceAccountBackdrop_PointerPressed">
                <Border.Styles>
                    <Style Selector="Border">
                        <Style.Animations>
                            <Animation Duration="0:0:0.2">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Border.Styles>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      PointerPressed="AssociateResourceAccountCard_PointerPressed">
                    <Border Classes="dialog" MinWidth="400" Margin="16">
                        <StackPanel>
                        <TextBlock Text="{loc:Translate Key=AutoAttendantsAssignDialogTitle}"
                                 Classes="dialog-title"/>
                        <TextBlock Text="{loc:Translate Key=CommonResourceAccountUpnLabel}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,8"/>
                        <TextBox Text="{Binding ResourceAccountUpn}"
                               Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Translate Key=CommonAutoAttendantNameLabel}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,8"/>
                        <TextBox Text="{Binding AutoAttendantName}"
                               Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Translate Key=AutoAttendantsAssignDialogDescription}"
                                 FontSize="12"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Right"
                                  Spacing="16">
                            <Button Command="{Binding CloseAssociateDialogCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Dismiss"/>
                                    <TextBlock Text="{loc:Translate Key=CommonCancel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                    Command="{Binding AssociateResourceAccountWithAutoAttendantCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon  Symbol="Link"/>
                                    <TextBlock Text="{loc:Translate Key=AutoAttendantsAssignResourceAccountAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Validate Call Queue Resource Account Dialog - Border overlay -->
            <Border IsVisible="{Binding ShowValidateCallQueueDialog}"
                    Background="#80000000"
                    ZIndex="1000"
                    PointerPressed="ValidateCallQueueBackdrop_PointerPressed">
                <Border.Styles>
                    <Style Selector="Border">
                        <Style.Animations>
                            <Animation Duration="0:0:0.2">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Border.Styles>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      PointerPressed="ValidateCallQueueCard_PointerPressed">
                    <Border Classes="dialog" MinWidth="400" Margin="16">
                        <StackPanel>
                        <TextBlock Text="{loc:Translate Key=AutoAttendantsValidateDialogTitle}"
                                 Classes="dialog-title"/>
                        <TextBlock Text="{loc:Translate Key=CommonCallQueueResourceAccountUpnLabel}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,8"/>
                        <TextBox Text="{Binding CallQueueUpn}"
                               Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Translate Key=AutoAttendantsValidateDialogDescription}"
                                 FontSize="12"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Right"
                                  Spacing="16">
                            <Button Command="{Binding CloseValidateCallQueueDialogCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Dismiss"/>
                                    <TextBlock Text="{loc:Translate Key=CommonCancel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                    Command="{Binding ValidateCallQueueResourceAccountCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon  Symbol="Person"/>
                                    <TextBlock Text="{loc:Translate Key=AutoAttendantsValidateCallQueueAccountAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Create Call Target Dialog - Border overlay -->
            <Border IsVisible="{Binding ShowCreateCallTargetDialog}"
                    Background="#80000000"
                    ZIndex="1000"
                    PointerPressed="CreateCallTargetBackdrop_PointerPressed">
                <Border.Styles>
                    <Style Selector="Border">
                        <Style.Animations>
                            <Animation Duration="0:0:0.2">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Border.Styles>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      PointerPressed="CreateCallTargetCard_PointerPressed">
                    <Border Classes="dialog" MinWidth="400" Margin="16">
                        <StackPanel>
                        <TextBlock Text="{loc:Translate Key=AutoAttendantsCreateForwardingTargetTitle}"
                                 Classes="dialog-title"/>
                        <TextBlock Text="{loc:Translate Key=AutoAttendantsCreateForwardingTargetDescription}"
                                 FontSize="12"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Right"
                                  Spacing="16">
                            <Button Command="{Binding CloseCreateCallTargetDialogCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Dismiss"/>
                                    <TextBlock Text="{loc:Translate Key=CommonCancel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                    Command="{Binding CreateCallTargetCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon  Symbol="PersonArrowRight"/>
                                    <TextBlock Text="{loc:Translate Key=AutoAttendantsCreateForwardingTargetAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Create Default Call Flow Dialog - Border overlay -->
            <Border IsVisible="{Binding ShowCreateDefaultCallFlowDialog}"
                    Background="#80000000"
                    ZIndex="1000"
                    PointerPressed="CreateDefaultCallFlowBackdrop_PointerPressed">
                <Border.Styles>
                    <Style Selector="Border">
                        <Style.Animations>
                            <Animation Duration="0:0:0.2">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Border.Styles>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      PointerPressed="CreateDefaultCallFlowCard_PointerPressed">
                    <Border Classes="dialog" MinWidth="400" Margin="16">
                        <StackPanel>
                        <TextBlock Text="{loc:Translate Key=AutoAttendantsCreateDefaultCallFlowTitle}"
                                 Classes="dialog-title"/>
                        <TextBlock Text="{loc:Translate Key=AutoAttendantsCreateDefaultCallFlowDescription}"
                                 FontSize="12"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Right"
                                  Spacing="16">
                            <Button Command="{Binding CloseCreateDefaultCallFlowDialogCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Dismiss"/>
                                    <TextBlock Text="{loc:Translate Key=CommonCancel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                    Command="{Binding CreateDefaultCallFlowCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon  Symbol="CallForward"/>
                                    <TextBlock Text="{loc:Translate Key=AutoAttendantsCreateDefaultCallFlowAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Create After Hours Call Flow Dialog - Border overlay -->
            <Border IsVisible="{Binding ShowCreateAfterHoursCallFlowDialog}"
                    Background="#80000000"
                    ZIndex="1000"
                    PointerPressed="CreateAfterHoursCallFlowBackdrop_PointerPressed">
                <Border.Styles>
                    <Style Selector="Border">
                        <Style.Animations>
                            <Animation Duration="0:0:0.2">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Border.Styles>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      PointerPressed="CreateAfterHoursCallFlowCard_PointerPressed">
                    <Border Classes="dialog" MinWidth="400" Margin="16">
                        <StackPanel>
                        <TextBlock Text="{loc:Translate Key=AutoAttendantsCreateAfterHoursCallFlowTitle}"
                                 Classes="dialog-title"/>
                        <TextBlock Text="{loc:Translate Key=AutoAttendantsCreateAfterHoursCallFlowDescription}"
                                 FontSize="12"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Right"
                                  Spacing="16">
                            <Button Command="{Binding CloseCreateAfterHoursCallFlowDialogCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Dismiss"/>
                                    <TextBlock Text="{loc:Translate Key=CommonCancel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                    Command="{Binding CreateAfterHoursCallFlowCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon  Symbol="CallEnd"/>
                                    <TextBlock Text="{loc:Translate Key=AutoAttendantsCreateAfterHoursCallFlowAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Create After Hours Schedule Dialog - Border overlay -->
            <Border IsVisible="{Binding ShowCreateAfterHoursScheduleDialog}"
                    Background="#80000000"
                    ZIndex="1000"
                    PointerPressed="CreateAfterHoursScheduleBackdrop_PointerPressed">
                <Border.Styles>
                    <Style Selector="Border">
                        <Style.Animations>
                            <Animation Duration="0:0:0.2">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Border.Styles>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      PointerPressed="CreateAfterHoursScheduleCard_PointerPressed">
                    <Border Classes="dialog" MinWidth="400" Margin="16">
                        <StackPanel>
                        <TextBlock Text="{loc:Translate Key=AutoAttendantsCreateAfterHoursScheduleTitle}"
                                 Classes="dialog-title"/>
                        <TextBlock Text="{loc:Translate Key=AutoAttendantsCreateAfterHoursScheduleDescription}"
                                 FontSize="12"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Right"
                                  Spacing="16">
                            <Button Command="{Binding CloseCreateAfterHoursScheduleDialogCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Dismiss"/>
                                    <TextBlock Text="{loc:Translate Key=CommonCancel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                    Command="{Binding CreateAfterHoursScheduleCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon  Symbol="Clock"/>
                                    <TextBlock Text="{loc:Translate Key=AutoAttendantsCreateAfterHoursScheduleAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Create Call Handling Association Dialog - Border overlay -->
            <Border IsVisible="{Binding ShowCreateCallHandlingAssociationDialog}"
                    Background="#80000000"
                    ZIndex="1000"
                    PointerPressed="CreateCallHandlingAssociationBackdrop_PointerPressed">
                <Border.Styles>
                    <Style Selector="Border">
                        <Style.Animations>
                            <Animation Duration="0:0:0.2">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Border.Styles>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      PointerPressed="CreateCallHandlingAssociationCard_PointerPressed">
                    <Border Classes="dialog" MinWidth="400" Margin="16">
                        <StackPanel>
                        <TextBlock Text="{loc:Translate Key=AutoAttendantsLinkScheduleToCallFlowTitle}"
                                 Classes="dialog-title"/>
                        <TextBlock Text="{loc:Translate Key=AutoAttendantsLinkScheduleToCallFlowDescription}"
                                 FontSize="12"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Right"
                                  Spacing="16">
                            <Button Command="{Binding CloseCreateCallHandlingAssociationDialogCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Dismiss"/>
                                    <TextBlock Text="{loc:Translate Key=CommonCancel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                    Command="{Binding CreateCallHandlingAssociationCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon  Symbol="Link"/>
                                    <TextBlock Text="{loc:Translate Key=AutoAttendantsLinkScheduleToCallFlowAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Progress Indicator -->
            <Grid Opacity="0.8"
                  IsVisible="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="360">
                    <ProgressBar
                               Minimum="0"
                               Maximum="100"
                               Value="{Binding ProgressValue}"
                               IsIndeterminate="{Binding IsProgressIndeterminate}"
                               Width="200"/>
                    <!-- Waiting Message -->
                    <TextBlock Text="{Binding WaitingMessage, TargetNullValue={x:Static sys:String.Empty}}"
                               FontSize="14"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                    <!-- Native PowerShell progress detail -->
                    <TextBlock Text="{Binding ProgressText}"
                               IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                    <!-- Cancel affordance -->
                    <Button Content="{loc:Translate Key=CommonCancel}"
                            Command="{Binding CancelOperationCommand}"
                            IsVisible="{Binding IsCancellable}"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
    </Grid>
</UserControl> 
