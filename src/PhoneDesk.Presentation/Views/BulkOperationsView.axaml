<UserControl xmlns="https://github.com/avaloniaui"
             x:Class="PhoneDesk.Views.BulkOperationsView"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:fic="using:FluentIcons.Common"
             xmlns:loc="clr-namespace:PhoneDesk.Localization"
             xmlns:local="clr-namespace:PhoneDesk.Views"
             xmlns:viewmodels="clr-namespace:PhoneDesk.ViewModels"
             xmlns:converters="clr-namespace:PhoneDesk.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Ellipsis-trim long identifiers in the Parsed Entries grid so rows stay distinguishable. -->
        <Style Selector="DataGridCell TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Border Classes="card" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="24,24,24,16">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,14">
                        <Border Grid.Column="0" Classes="icon-badge" VerticalAlignment="Top">
                            <fi:SymbolIcon Symbol="TableMultiple"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="{loc:Translate Key=MainNavigationBulkOperations}"
                                     Classes="page-title"
                                     Margin="0"/>
                            <TextBlock Text="{loc:Translate Key=BulkOperationsSubtitle}"
                                     TextWrapping="Wrap"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Action Buttons — wrap so no button is clipped at narrow widths. -->
                    <WrapPanel Orientation="Horizontal">
                        <WrapPanel.Styles>
                            <Style Selector="WrapPanel > Button">
                                <Setter Property="Margin" Value="0,0,8,8"/>
                            </Style>
                        </WrapPanel.Styles>
                        <Button Command="{Binding ExportTemplateFileCommand}" Classes="IconText">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="ArrowDownload"/>
                                <TextBlock Text="{loc:Translate Key=BulkOperationsDownloadTemplateAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportCsvFileCommand}" Classes="IconText">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="ArrowUpload"/>
                                <TextBlock Text="{loc:Translate Key=BulkOperationsImportCsvAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GenerateTemplateCommand}" Classes="IconText">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="DocumentAdd"/>
                                <TextBlock Text="{loc:Translate Key=BulkOperationsGenerateTemplateAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ParseCsvCommand}" IsEnabled="{Binding !IsBusy}" Classes="IconText">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="TableSearch"/>
                                <TextBlock Text="{loc:Translate Key=BulkOperationsParseCsvAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding PreviewScriptCommand}" IsEnabled="{Binding !IsBusy}" Classes="IconText">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="Eye"/>
                                <TextBlock Text="{loc:Translate Key=BulkOperationsPreviewScriptAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GeneratePlanCommand}" IsEnabled="{Binding !IsBusy}" Classes="IconText">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="ClipboardTaskListLtr"/>
                                <TextBlock Text="{loc:Translate Key=BulkOperationsDryRunPlanAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExecuteAllCommand}"
                                Classes="accent IconText"
                                IsEnabled="{Binding !IsBusy}">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="Play"/>
                                <TextBlock Text="{loc:Translate Key=BulkOperationsExecuteAllAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- Dry-run plan export + safety toggle -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,0">
                        <Button Command="{Binding ExportPlanJsonCommand}" IsEnabled="{Binding !IsBusy}" Classes="IconText">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="Code"/>
                                <TextBlock Text="{loc:Translate Key=BulkOperationsExportPlanJsonAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportPlanCsvCommand}" IsEnabled="{Binding !IsBusy}" Classes="IconText">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="DocumentTable"/>
                                <TextBlock Text="{loc:Translate Key=BulkOperationsExportPlanCsvAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <CheckBox IsChecked="{Binding SkipInvalidRows}"
                                  Content="{loc:Translate Key=BulkOperationsSkipInvalidRowsToggle}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Status -->
                    <TextBlock Text="{Binding StatusMessage}"
                             Margin="0,10,0,0"
                             FontSize="13"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <!-- Progress -->
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressValue}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 IsVisible="{Binding IsExecuting}"
                                 Margin="0,6,0,0"/>
                    <!-- Native PowerShell progress detail -->
                    <TextBlock Text="{Binding ProgressText}"
                               IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <!-- Cancel affordance -->
                    <Button Content="{loc:Translate Key=CommonCancel}"
                            Command="{Binding CancelOperationCommand}"
                            IsVisible="{Binding IsCancellable}"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Content Tabs -->
                <TabControl Grid.Row="1" Margin="24,0,24,24">
                    <!-- CSV Editor Tab -->
                    <TabItem Header="{loc:Translate Key=BulkOperationsCsvDataTab}">
                        <Border Classes="sunken"
                                CornerRadius="0,0,10,10"
                                Margin="0">
                            <TextBox Text="{Binding CsvContent}"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     FontFamily="{StaticResource CodeFontFamily}"
                                     FontSize="12"
                                     BorderThickness="0"
                                     Padding="12"
                                     Watermark="{loc:Translate Key=BulkOperationsCsvDataWatermark}"/>
                        </Border>
                    </TabItem>

                    <!-- Parsed Entries Tab -->
                    <TabItem Header="{loc:Translate Key=BulkOperationsParsedEntriesTab}">
                        <DataGrid ItemsSource="{Binding ParsedEntries}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Translate Key=BulkOperationsCustomerColumn}" Binding="{Binding Customer}" Width="120"/>
                                <DataGridTextColumn Header="{loc:Translate Key=BulkOperationsGroupColumn}" Binding="{Binding GroupName}" Width="120"/>
                                <DataGridTextColumn Header="{loc:Translate Key=BulkOperationsM365GroupColumn}" Binding="{Binding M365Group}" Width="180"/>
                                <DataGridTextColumn Header="{loc:Translate Key=BulkOperationsCallQueueColumn}" Binding="{Binding CqDisplayName}" Width="180"/>
                                <DataGridTextColumn Header="{loc:Translate Key=BulkOperationsAutoAttendantColumn}" Binding="{Binding AaDisplayName}" Width="200"/>
                                <DataGridTextColumn Header="{loc:Translate Key=BulkOperationsPhoneColumn}" Binding="{Binding PhoneNumber}" Width="140"/>
                                <DataGridTextColumn Header="{loc:Translate Key=BulkOperationsLanguageColumn}" Binding="{Binding Language}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- Dry-Run Plan Tab -->
                    <TabItem Header="{loc:Translate Key=BulkOperationsDryRunPlanTab}">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0"
                                       Margin="0,8,0,8"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       IsVisible="{Binding Plan, Converter={x:Static ObjectConverters.IsNull}}"
                                       Text="{loc:Translate Key=BulkOperationsDryRunPlanHint}"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Plan.Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="card" Margin="0,0,0,10" Padding="14">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <Panel Grid.Column="0" VerticalAlignment="Top" Margin="0,1,8,0">
                                                            <fi:SymbolIcon Symbol="CheckmarkCircle"
                                                                           Foreground="Green"
                                                                           IsVisible="{Binding IsValid}"/>
                                                            <fi:SymbolIcon Symbol="ErrorCircle"
                                                                           Foreground="OrangeRed"
                                                                           IsVisible="{Binding !IsValid}"/>
                                                        </Panel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Margin="12,0,0,0"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   VerticalAlignment="Center">
                                                            <Run Text="{loc:Translate Key=BulkOperationsRowLabel}"/>
                                                            <Run Text="{Binding RowNumber}"/>
                                                        </TextBlock>
                                                    </Grid>

                                                    <!-- Validation errors -->
                                                    <ItemsControl ItemsSource="{Binding ValidationErrors}"
                                                                  IsVisible="{Binding ValidationErrors.Count}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" Foreground="OrangeRed" FontSize="12" TextWrapping="Wrap"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Planned objects -->
                                                    <ItemsControl ItemsSource="{Binding Objects}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnDefinitions="Auto,*" Margin="12,2,0,2">
                                                                    <fi:SymbolIcon Grid.Column="0" Symbol="ChevronRight" FontSize="12"
                                                                                   VerticalAlignment="Top" Margin="0,2,8,0"/>
                                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                                        <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding Upn}" FontSize="12"
                                                                                   TextWrapping="Wrap"
                                                                                   IsVisible="{Binding Upn, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Preflight checks -->
                                                    <ItemsControl ItemsSource="{Binding PreflightChecks}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock FontSize="11"
                                                                           Margin="12,1,0,1"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                                    <Run Text="{loc:Translate Key=BulkOperationsPreflightLabel}"/>
                                                                    <Run Text="{Binding Detail}"/>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- Script Preview Tab -->
                    <TabItem Header="{loc:Translate Key=BulkOperationsScriptPreviewTab}">
                        <Border Classes="sunken"
                                CornerRadius="0,0,10,10">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding ScriptPreview}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="{StaticResource CodeFontFamily}"
                                         FontSize="12"
                                         BorderThickness="0"
                                         Padding="12"
                                         Watermark="{loc:Translate Key=BulkOperationsScriptPreviewWatermark}"/>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                    <!-- Execution Log Tab -->
                    <TabItem Header="{loc:Translate Key=BulkOperationsExecutionLogTab}">
                        <Border Classes="sunken"
                                CornerRadius="0,0,10,10">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding ExecutionLog}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         FontFamily="{StaticResource CodeFontFamily}"
                                         FontSize="12"
                                         BorderThickness="0"
                                         Padding="12"
                                         Watermark="{loc:Translate Key=BulkOperationsExecutionLogWatermark}"/>
                            </ScrollViewer>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
