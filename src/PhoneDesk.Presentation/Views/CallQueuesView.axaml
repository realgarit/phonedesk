<UserControl x:Class="PhoneDesk.Views.CallQueuesView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:fic="using:FluentIcons.Common"
             xmlns:loc="clr-namespace:PhoneDesk.Localization"
             xmlns:local="clr-namespace:PhoneDesk.Views"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:viewmodels="clr-namespace:PhoneDesk.ViewModels"
             xmlns:converters="clr-namespace:PhoneDesk.Converters"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <!-- DataContext is set via data binding from MainWindow -->

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Ellipsis-trim long values in list grids so rows stay distinguishable and the
             rightmost column's text can never disappear under the vertical scrollbar. -->
        <Style Selector="DataGridCell TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="card" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Main Content -->
            <Grid Grid.Row="0" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Page Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Classes="icon-badge">
                        <fi:SymbolIcon Symbol="CallInbound"/>
                    </Border>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Translate Key=MainNavigationCallQueues}" Classes="page-title" Margin="0"/>
                        <TextBlock Text="{loc:Translate Key=CallQueuesSubtitle}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
                </StackPanel>

                <!-- Status Message -->
                <ui:InfoBar Grid.Row="1"
                           Title="{Binding StatusMessage}"
                           IsOpen="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           IsClosable="True"
                           Margin="0,0,0,12"/>

                <!-- Tab Control -->
                <TabControl Grid.Row="2">
                    <!-- Resource Accounts Tab -->
                    <TabItem Header="{loc:Translate Key=CommonResourceAccountsTab}">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Resource Accounts Actions -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{Binding RetrieveResourceAccountsCommand}"
                                        ToolTip.Tip="{loc:Translate Key=ProvisioningLoadResourceAccountsTooltip}"
                                        AutomationProperties.Name="{loc:Translate Key=ProvisioningLoadResourceAccountsAutomationName}"
                                        Margin="0,0,16,0" Classes="IconText">
                                    <StackPanel Orientation="Horizontal">
                                        <fi:SymbolIcon  Symbol="ArrowSync"/>
                                        <TextBlock Text="{loc:Translate Key=ProvisioningLoadResourceAccountsAction}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1"
                                        Command="{Binding OpenCreateResourceAccountDialogCommand}"
                                        ToolTip.Tip="{loc:Translate Key=ProvisioningCreateResourceAccountTooltip}"
                                        AutomationProperties.Name="{loc:Translate Key=ProvisioningCreateResourceAccountAutomationName}"
                                        Margin="0,0,8,0" Classes="IconText">
                                    <StackPanel Orientation="Horizontal">
                                        <fi:SymbolIcon  Symbol="PersonAdd"/>
                                        <TextBlock Text="{loc:Translate Key=ProvisioningCreateResourceAccountAction}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Command="{Binding RemoveResourceAccountCommand}"
                                        ToolTip.Tip="{loc:Translate Key=ProvisioningDeleteResourceAccountTooltip}"
                                        AutomationProperties.Name="{loc:Translate Key=ProvisioningDeleteResourceAccountAutomationName}"
                                        Margin="0,0,16,0" Classes="IconText">
                                    <StackPanel Orientation="Horizontal">
                                        <fi:SymbolIcon Symbol="PersonDelete" Foreground="OrangeRed"/>
                                        <TextBlock Text="{loc:Translate Key=ProvisioningDeleteResourceAccountAction}" VerticalAlignment="Center" Foreground="OrangeRed"/>
                                    </StackPanel>
                                </Button>

                                <TextBox Grid.Column="3"
                                         Text="{Binding SearchResourceAccountsText}"
                                         Watermark="{loc:Translate Key=ProvisioningSearchResourceAccountsWatermark}"
                                         ToolTip.Tip="{loc:Translate Key=ProvisioningSearchResourceAccountsTooltip}"
                                         AutomationProperties.Name="{loc:Translate Key=ProvisioningSearchResourceAccountsAutomationName}"/>
                            </Grid>

                            <!-- Resource Accounts List -->
                            <Grid Grid.Row="2">
                                <DataGrid AutomationProperties.Name="{loc:Translate Key=ProvisioningResourceAccountsGridAutomationName}"
                                          ItemsSource="{Binding ResourceAccountsView}"
                                          AutoGenerateColumns="False"
                                          HeadersVisibility="Column"
                                          IsReadOnly="True"
                                          GridLinesVisibility="None"
                                          SelectionMode="Single"
                                          HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Translate Key=CommonDisplayNameColumn}" Binding="{Binding DisplayName}" Width="2*"/>
                                        <DataGridTextColumn Header="{loc:Translate Key=CommonUpnColumn}" Binding="{Binding UserPrincipalName}" Width="2*"/>
                                        <DataGridTextColumn Header="{loc:Translate Key=CommonIdentityColumn}" Binding="{Binding Identity}" Width="2*"/>
                                        <DataGridTextColumn Header="{loc:Translate Key=CommonUsageLocationColumn}" Binding="{Binding UsageLocation}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <!-- Empty State -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsVisible="{Binding !ResourceAccountsView.Count}"
                                            Opacity="0.85" Spacing="10">
                                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                                        <fi:SymbolIcon Symbol="PersonSearch" IsFilled="True" FontSize="26" Foreground="{DynamicResource TeamsPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                                    </Border>
                                    <TextBlock Text="{loc:Translate Key=ProvisioningNoResourceAccountsLoadedTitle}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{loc:Translate Key=ProvisioningNoResourceAccountsLoadedDescription}" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Call Queues Tab -->
                    <TabItem Header="{loc:Translate Key=MainNavigationCallQueues}">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Call Queues Actions -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{Binding RetrieveCallQueuesCommand}"
                                        ToolTip.Tip="{loc:Translate Key=CallQueuesLoadTooltip}"
                                        AutomationProperties.Name="{loc:Translate Key=CallQueuesLoadAutomationName}"
                                        Margin="0,0,16,0" Classes="IconText">
                                    <StackPanel Orientation="Horizontal">
                                        <fi:SymbolIcon  Symbol="ArrowSync"/>
                                        <TextBlock Text="{loc:Translate Key=CallQueuesLoadAction}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1"
                                        Command="{Binding OpenCreateCallQueueDialogCommand}"
                                        ToolTip.Tip="{loc:Translate Key=CallQueuesCreateTooltip}"
                                        AutomationProperties.Name="{loc:Translate Key=CallQueuesCreateAutomationName}"
                                        Margin="0,0,8,0" Classes="IconText">
                                    <StackPanel Orientation="Horizontal">
                                        <fi:SymbolIcon  Symbol="CallAdd"/>
                                        <TextBlock Text="{loc:Translate Key=CallQueuesCreateAction}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Command="{Binding RemoveCallQueueCommand}"
                                        ToolTip.Tip="{loc:Translate Key=CallQueuesDeleteTooltip}"
                                        AutomationProperties.Name="{loc:Translate Key=CallQueuesDeleteAutomationName}"
                                        Margin="0,0,16,0" Classes="IconText">
                                    <StackPanel Orientation="Horizontal">
                                        <fi:SymbolIcon Symbol="CallDismiss" Foreground="OrangeRed"/>
                                        <TextBlock Text="{loc:Translate Key=CallQueuesDeleteAction}" VerticalAlignment="Center" Foreground="OrangeRed"/>
                                    </StackPanel>
                                </Button>

                                <TextBox Grid.Column="3"
                                         Text="{Binding SearchCallQueuesText}"
                                         Watermark="{loc:Translate Key=CallQueuesSearchWatermark}"
                                         ToolTip.Tip="{loc:Translate Key=CallQueuesSearchTooltip}"
                                         AutomationProperties.Name="{loc:Translate Key=CallQueuesSearchAutomationName}"/>
                            </Grid>

                            <!-- Call Queues List -->
                            <Grid Grid.Row="2">
                                <DataGrid AutomationProperties.Name="{loc:Translate Key=CallQueuesGridAutomationName}"
                                          ItemsSource="{Binding CallQueuesView}"
                                          AutoGenerateColumns="False"
                                          HeadersVisibility="Column"
                                          IsReadOnly="True"
                                          GridLinesVisibility="None"
                                          SelectionMode="Single"
                                          HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Translate Key=CommonNameColumn}" Binding="{Binding Name}" Width="2*"/>
                                        <DataGridTextColumn Header="{loc:Translate Key=CommonIdentityColumn}" Binding="{Binding Identity}" Width="2*"/>
                                        <DataGridTextColumn Header="{loc:Translate Key=CallQueuesRoutingMethodColumn}" Binding="{Binding RoutingMethod}" Width="*"/>
                                        <DataGridTextColumn Header="{loc:Translate Key=CallQueuesAgentAlertTimeColumn}" Binding="{Binding AgentAlertTime}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <!-- Empty State -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsVisible="{Binding !CallQueuesView.Count}"
                                            Opacity="0.85" Spacing="10">
                                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                                        <fi:SymbolIcon Symbol="CallInbound" IsFilled="True" FontSize="26" Foreground="{DynamicResource TeamsPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                                    </Border>
                                    <TextBlock Text="{loc:Translate Key=CallQueuesEmptyTitle}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{loc:Translate Key=CallQueuesEmptyDescription}" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Step-by-Step Creation Tab -->
                    <TabItem Header="{loc:Translate Key=MainNavigationGuidedSetup}">
                        <ScrollViewer Margin="16">
                            <StackPanel>
                                <TextBlock Text="{loc:Translate Key=CallQueuesGuidedSetupIntro}"
                                         FontSize="18"
                                 FontWeight="SemiBold"
                                         Margin="0,0,0,24"/>

                                <!-- Step 1: Create Resource Account -->
                                <Border Classes="card interactive" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=CallQueuesStep1Title}"
                                                 FontSize="18"
                                                 FontWeight="Bold"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="{loc:Translate Key=CallQueuesStep1Description}"
                                                 FontSize="14"
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,0,16"/>
                                        <Button
                                                Command="{Binding OpenCreateResourceAccountDialogCommand}"
                                                HorizontalAlignment="Left" Classes="IconText">
                                            <StackPanel Orientation="Horizontal">
                                                <fi:SymbolIcon  Symbol="PersonAdd"/>
                                                <TextBlock Text="{loc:Translate Key=ProvisioningCreateResourceAccountAction}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Step 2: Update Usage Location -->
                                <Border Classes="card interactive" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=ProvisioningStep2Title}"
                                                 FontSize="18"
                                                 FontWeight="Bold"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="{loc:Translate Key=ProvisioningStep2Description}"
                                                 FontSize="14"
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,0,16"/>
                                        <Button
                                                Command="{Binding OpenUpdateUsageLocationDialogCommand}"
                                                HorizontalAlignment="Left" Classes="IconText">
                                            <StackPanel Orientation="Horizontal">
                                                <fi:SymbolIcon  Symbol="Location"/>
                                                <TextBlock Text="{loc:Translate Key=ProvisioningUpdateUsageLocationAction}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Step 3: Assign License -->
                                <Border Classes="card interactive" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=ProvisioningStep3Title}"
                                                 FontSize="18"
                                                 FontWeight="Bold"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="{loc:Translate Key=ProvisioningStep3Description}"
                                                 FontSize="14"
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,0,16"/>
                                        <Button
                                                Command="{Binding AssignLicenseCommand}"
                                                HorizontalAlignment="Left" Classes="IconText">
                                            <StackPanel Orientation="Horizontal">
                                                <fi:SymbolIcon  Symbol="Certificate"/>
                                                <TextBlock Text="{loc:Translate Key=ProvisioningAssignLicenseAction}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Step 4: Get M365 Group ID -->
                                <Border Classes="card interactive" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=CallQueuesStep4Title}"
                                                 FontSize="18"
                                                 FontWeight="Bold"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="{loc:Translate Key=CallQueuesStep4Description}"
                                                 FontSize="14"
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,0,16"/>
                                        <Button
                                                Command="{Binding GetM365GroupIdCommand}"
                                                HorizontalAlignment="Left" Classes="IconText">
                                            <StackPanel Orientation="Horizontal">
                                                <fi:SymbolIcon  Symbol="PersonSearch"/>
                                                <TextBlock Text="{loc:Translate Key=CallQueuesLoadM365GroupIdAction}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Step 5: Create Call Queue -->
                                <Border Classes="card interactive" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=CallQueuesStep5Title}"
                                                 FontSize="18"
                                                 FontWeight="Bold"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="{loc:Translate Key=CallQueuesStep5Description}"
                                                 FontSize="14"
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,0,16"/>
                                        <Button
                                                Command="{Binding OpenCreateCallQueueDialogCommand}"
                                                HorizontalAlignment="Left" Classes="IconText">
                    <StackPanel Orientation="Horizontal">
                        <fi:SymbolIcon  Symbol="CallAdd"/>
                        <TextBlock Text="{loc:Translate Key=CallQueuesCreateCallQueueAction}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Step 6: Associate Resource Account -->
                                <Border Classes="card interactive" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Key=CallQueuesStep6Title}"
                                                 FontSize="18"
                                                 FontWeight="Bold"
                                                 Margin="0,0,0,8"/>
                                        <TextBlock Text="{loc:Translate Key=CallQueuesStep6Description}"
                                                 FontSize="14"
                                                 TextWrapping="Wrap"
                                                 Margin="0,0,0,16"/>
                                        <Button
                                                Command="{Binding OpenAssociateDialogCommand}"
                                                HorizontalAlignment="Left" Classes="IconText">
                                            <StackPanel Orientation="Horizontal">
                                                <fi:SymbolIcon  Symbol="Link"/>
                                                <TextBlock Text="{loc:Translate Key=CallQueuesAssignResourceAccountAction}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Create Resource Account Dialog - Border overlay -->
            <Border IsVisible="{Binding ShowCreateResourceAccountDialog}"
                    Background="#80000000"
                    ZIndex="1000"
                    PointerPressed="CreateResourceAccountBackdrop_PointerPressed">
                <Border.Styles>
                    <Style Selector="Border">
                        <Style.Animations>
                            <Animation Duration="0:0:0.2">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Border.Styles>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      PointerPressed="CreateResourceAccountCard_PointerPressed">
                    <Border Classes="dialog" MinWidth="400" Margin="16">
                        <StackPanel>
                        <TextBlock Text="{loc:Translate Key=ProvisioningCreateResourceAccountTitle}"
                                 Classes="dialog-title"/>
                        <TextBlock Text="{loc:Translate Key=CommonUpnLabel}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,8"/>
                        <TextBox Text="{Binding ResourceAccountUpn}"
                               Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Translate Key=CommonDisplayNameLabel}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,8"/>
                        <TextBox Text="{Binding ResourceAccountDisplayName}"
                               Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Translate Key=ProvisioningCreateResourceAccountDescription}"
                                 FontSize="12"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Right"
                                  Spacing="16">
                            <Button Command="{Binding CloseCreateResourceAccountDialogCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Dismiss"/>
                                    <TextBlock Text="{loc:Translate Key=CommonCancel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                    Command="{Binding CreateResourceAccountCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon  Symbol="PersonAdd"/>
                                    <TextBlock Text="{loc:Translate Key=ProvisioningCreateResourceAccountAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Update Usage Location Dialog - Border overlay -->
            <Border IsVisible="{Binding ShowUpdateUsageLocationDialog}"
                    Background="#80000000"
                    ZIndex="1000"
                    PointerPressed="UpdateUsageLocationBackdrop_PointerPressed">
                <Border.Styles>
                    <Style Selector="Border">
                        <Style.Animations>
                            <Animation Duration="0:0:0.2">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Border.Styles>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      PointerPressed="UpdateUsageLocationCard_PointerPressed">
                    <Border Classes="dialog" MinWidth="400" Margin="16">
                        <StackPanel>
                        <TextBlock Text="{loc:Translate Key=ProvisioningUpdateUsageLocationTitle}"
                                 Classes="dialog-title"/>
                        <TextBlock Text="{loc:Translate Key=CommonResourceAccountUpnLabel}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,8"/>
                        <TextBox Text="{Binding ResourceAccountUpn}"
                               IsReadOnly="True"
                               Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Translate Key=ProvisioningUpdateUsageLocationDescription}"
                                 FontSize="12"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Right"
                                  Spacing="16">
                            <Button Command="{Binding CloseUpdateUsageLocationDialogCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Dismiss"/>
                                    <TextBlock Text="{loc:Translate Key=CommonCancel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                    Command="{Binding UpdateUsageLocationCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon  Symbol="Location"/>
                                    <TextBlock Text="{loc:Translate Key=ProvisioningUpdateUsageLocationAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Create Call Queue Dialog - Border overlay -->
            <Border IsVisible="{Binding ShowCreateCallQueueDialog}"
                    Background="#80000000"
                    ZIndex="1000"
                    PointerPressed="CreateCallQueueBackdrop_PointerPressed">
                <Border.Styles>
                    <Style Selector="Border">
                        <Style.Animations>
                            <Animation Duration="0:0:0.2">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Border.Styles>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      PointerPressed="CreateCallQueueCard_PointerPressed">
                    <Border Classes="dialog" MinWidth="400" Margin="16">
                        <StackPanel>
                        <TextBlock Text="{loc:Translate Key=CallQueuesCreateDialogTitle}"
                                 Classes="dialog-title"/>
                        <TextBlock Text="{loc:Translate Key=CommonCallQueueNameLabel}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,8"/>
                        <TextBox Text="{Binding CallQueueName}"
                               Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Translate Key=CommonM365GroupIdLabel}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,8"/>
                        <TextBox Text="{Binding M365GroupId}"
                               Margin="0,0,0,8"/>
                        <TextBlock Text="{loc:Translate Key=CallQueuesCreateDialogNote}"
                                 FontSize="12"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Translate Key=CallQueuesCreateDialogDescription}"
                                 FontSize="12"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Right"
                                  Spacing="16">
                            <Button Command="{Binding CloseCreateCallQueueDialogCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Dismiss"/>
                                    <TextBlock Text="{loc:Translate Key=CommonCancel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                    Command="{Binding CreateCallQueueCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon  Symbol="CallAdd"/>
                                    <TextBlock Text="{loc:Translate Key=CallQueuesCreateAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Associate Resource Account Dialog - Border overlay -->
            <Border IsVisible="{Binding ShowAssociateDialog}"
                    Background="#80000000"
                    ZIndex="1000"
                    PointerPressed="AssociateResourceAccountBackdrop_PointerPressed">
                <Border.Styles>
                    <Style Selector="Border">
                        <Style.Animations>
                            <Animation Duration="0:0:0.2">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Border.Styles>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      PointerPressed="AssociateResourceAccountCard_PointerPressed">
                    <Border Classes="dialog" MinWidth="400" Margin="16">
                        <StackPanel>
                        <TextBlock Text="{loc:Translate Key=CallQueuesAssignDialogTitle}"
                                 Classes="dialog-title"/>
                        <TextBlock Text="{loc:Translate Key=CommonResourceAccountUpnLabel}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,8"/>
                        <TextBox Text="{Binding ResourceAccountUpn}"
                               Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Translate Key=CommonCallQueueNameLabel}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,8"/>
                        <TextBox Text="{Binding CallQueueName}"
                               Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Translate Key=CallQueuesAssignDialogDescription}"
                                 FontSize="12"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Right"
                                  Spacing="16">
                            <Button Command="{Binding CloseAssociateDialogCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Dismiss"/>
                                    <TextBlock Text="{loc:Translate Key=CommonCancel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                    Command="{Binding AssociateResourceAccountWithCallQueueCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon  Symbol="Link"/>
                                    <TextBlock Text="{loc:Translate Key=CallQueuesAssignResourceAccountAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Progress Indicator -->
            <Grid Grid.RowSpan="2"
                  ZIndex="2000"
                  Background="#40000000"
                  IsVisible="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="360">
                    <ProgressBar
                               AutomationProperties.Name="{loc:Translate Key=CommonOperationProgressAutomationName}"
                               Minimum="0"
                               Maximum="100"
                               Value="{Binding ProgressValue}"
                               IsIndeterminate="{Binding IsProgressIndeterminate}"
                               Width="200"/>
                    <!-- Waiting Message -->
                    <TextBlock Text="{Binding WaitingMessage, TargetNullValue={x:Static sys:String.Empty}}"
                               FontSize="14"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                    <!-- Native PowerShell progress detail -->
                    <TextBlock Text="{Binding ProgressText}"
                               IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                    <!-- Cancel affordance -->
                    <Button Content="{loc:Translate Key=CommonCancel}"
                            Command="{Binding CancelOperationCommand}"
                            IsVisible="{Binding IsCancellable}"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl> 
