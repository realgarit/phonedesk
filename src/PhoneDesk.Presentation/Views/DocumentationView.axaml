<UserControl xmlns="https://github.com/avaloniaui"
             x:Class="PhoneDesk.Views.DocumentationView"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:fic="using:FluentIcons.Common"
             xmlns:loc="clr-namespace:PhoneDesk.Localization"
             xmlns:local="clr-namespace:PhoneDesk.Views"
             xmlns:viewmodels="clr-namespace:PhoneDesk.ViewModels"
             xmlns:converters="clr-namespace:PhoneDesk.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Border Classes="card" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="24,24,24,16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,0,0,16">
                        <Border Classes="icon-badge">
                            <fi:SymbolIcon Symbol="DocumentText"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Translate Key=DocumentationTitle}"
                                     Classes="page-title"
                                     Margin="0"/>
                            <TextBlock Text="{loc:Translate Key=DocumentationSubtitle}"
                                     TextWrapping="Wrap"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <WrapPanel Orientation="Horizontal" IsEnabled="{Binding !IsBusy}">
                        <Button Command="{Binding ExportDocumentationCommand}"
                                Classes="accent IconText" Margin="0,0,12,8"
                                IsEnabled="{Binding !IsBusy}">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="ArrowDownload"/>
                                <TextBlock Text="{loc:Translate Key=DocumentationExportAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CopyToClipboardCommand}"
                                Classes="IconText" Margin="0,0,12,8"
                                IsEnabled="{Binding !IsBusy}">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="Copy"/>
                                <TextBlock Text="{loc:Translate Key=CommonCopyToClipboard}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ExportTopologySnapshotCommand}"
                                Classes="IconText" Margin="0,0,12,8"
                                IsEnabled="{Binding HasCachedTopology}">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="Save"/>
                                <TextBlock Text="{loc:Translate Key=DocumentationExportTopologySnapshotAction}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CompareTopologySnapshotCommand}"
                                Classes="IconText" Margin="0,0,12,8"
                                IsEnabled="{Binding HasCachedTopology}">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="ArrowSync"/>
                                <TextBlock Text="{loc:Translate Key=DocumentationCompareTopologySnapshotAction}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Text="{loc:Translate Key=DocumentationTopologyLoadDashboardStatus}"
                               IsVisible="{Binding !HasCachedTopology}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <!-- Status -->
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                             Margin="0,12,0,0"
                             FontSize="13"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <!-- Progress indicator -->
                    <ProgressBar IsIndeterminate="True"
                                 IsVisible="{Binding IsExporting}"
                                 Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Documentation Output -->
                <Border Grid.Row="1"
                        Margin="24,0,24,24"
                        Classes="sunken"
                        Padding="0"
                        IsVisible="{Binding !ShowTopologyDrift}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding DocumentationOutput}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontFamily="{StaticResource CodeFontFamily}"
                                 FontSize="12"
                                 BorderThickness="0"
                                 Padding="16"
                                 Watermark="{loc:Translate Key=DocumentationWatermark}"/>
                    </ScrollViewer>
                </Border>

                <!-- Offline topology drift result; no tenant query is made from this view. -->
                <Border Grid.Row="1"
                        Margin="24,0,24,24"
                        Classes="sunken"
                        Padding="16"
                        IsVisible="{Binding ShowTopologyDrift}">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{loc:Translate Key=DocumentationTopologyDriftTitle}"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ComparedTopologyFileName}"
                                           FontFamily="{StaticResource CodeFontFamily}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{loc:Translate Key=DocumentationTopologyDriftDescription}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding ClearTopologyDriftCommand}"
                                    Classes="IconText"
                                    VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Dismiss"/>
                                    <TextBlock Text="{loc:Translate Key=DocumentationCloseDriftAction}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1">
                            <DataGrid ItemsSource="{Binding TopologyDriftEntries}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserResizeColumns="True"
                                      GridLinesVisibility="Horizontal"
                                      IsVisible="{Binding HasTopologyDriftEntries}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Translate Key=DocumentationTopologyChangeColumn}"
                                                        Binding="{Binding ChangeLabel}" Width="Auto"/>
                                    <DataGridTextColumn Header="{loc:Translate Key=DocumentationTopologyObjectColumn}"
                                                        Binding="{Binding DisplayName}" Width="1.5*"/>
                                    <DataGridTextColumn Header="{loc:Translate Key=DocumentationTopologyPropertyColumn}"
                                                        Binding="{Binding PropertyName}" Width="*"/>
                                    <DataGridTextColumn Header="{loc:Translate Key=DocumentationTopologySavedColumn}"
                                                        Binding="{Binding SnapshotValue}" Width="1.5*"/>
                                    <DataGridTextColumn Header="{loc:Translate Key=DocumentationTopologyLiveColumn}"
                                                        Binding="{Binding LiveValue}" Width="1.5*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Classes="card"
                                    Padding="24"
                                    IsVisible="{Binding !HasTopologyDriftEntries}">
                                <TextBlock Text="{loc:Translate Key=DocumentationTopologyDriftEmpty}"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Info Footer -->
                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceSunkenBrush}"
                        CornerRadius="0,0,12,12"
                        Padding="24,12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <fi:SymbolIcon Symbol="Info" FontSize="14"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{loc:Translate Key=DocumentationFooter}"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
