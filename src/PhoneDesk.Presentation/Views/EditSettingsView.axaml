<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:loc="clr-namespace:PhoneDesk.Localization"
             xmlns:controls="clr-namespace:PhoneDesk.Controls"
             x:Class="PhoneDesk.Views.EditSettingsView"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="760">
    <Grid>
        <Border Classes="card" Margin="0">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Margin="24,24,24,16" Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Classes="icon-badge" VerticalAlignment="Top">
                            <fi:SymbolIcon Symbol="Edit"/>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Translate Key=EditSettingsTitle}" Classes="page-title" Margin="0"/>
                            <controls:InfoButton Name="PageHelp" HelpTitle="{loc:Translate Key=EditSettingsTitle}" HelpText="{loc:Translate Key=EditSettingsSubtitle}"/>
                        </StackPanel>
                    </Grid>

                    <WrapPanel Orientation="Horizontal" IsEnabled="{Binding !IsBusy}">
                        <ComboBox SelectedIndex="{Binding KindIndex}" Width="230" Margin="0,0,12,8" VerticalAlignment="Center">
                            <ComboBoxItem Content="{loc:Translate Key=EditSettingsKindCallQueue}"/>
                            <ComboBoxItem Content="{loc:Translate Key=EditSettingsKindAutoAttendant}"/>
                        </ComboBox>
                        <TextBox Text="{Binding ObjectName}" Width="250" Margin="0,0,12,8"
                                 Watermark="{loc:Translate Key=EditSettingsNameWatermark}"/>
                        <Button Command="{Binding LoadCommand}" Classes="accent IconText" Margin="0,0,12,8">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="ArrowSync"/>
                                <TextBlock Text="{loc:Translate Key=EditSettingsLoadAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CheckCommand}" Classes="IconText" Margin="0,0,12,8" IsEnabled="{Binding IsLoaded}">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="Search"/>
                                <TextBlock Text="{loc:Translate Key=HolidayManagerCheckAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ApplyCommand}" Classes="IconText" Margin="0,0,12,8" IsEnabled="{Binding CanApply}">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="Checkmark"/>
                                <TextBlock Text="{loc:Translate Key=HolidayManagerApplyAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Border Grid.Row="1" Classes="sunken" Margin="24,0,24,8" Padding="24" IsVisible="{Binding ShowEmptyState}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <fi:SymbolIcon Symbol="Edit" FontSize="30" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{loc:Translate Key=EditSettingsEmptyTitle}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Translate Key=EditSettingsEmptyDescription}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="24,0,24,8" RowDefinitions="*,Auto" RowSpacing="8" IsVisible="{Binding IsLoaded}">
                    <Border Grid.Row="0" Classes="sunken" Padding="16">
                        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
                            <TextBlock Grid.Row="0" Text="{Binding LoadedTitle}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Text="{Binding Notes}" IsVisible="{Binding HasNotes}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Grid Grid.Row="2" ColumnDefinitions="260,*,*" ColumnSpacing="16" Margin="0,4,16,0">
                                <TextBlock Grid.Column="0" Text="{loc:Translate Key=EditSettingsColumnSetting}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{loc:Translate Key=EditSettingsColumnCurrent}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{loc:Translate Key=EditSettingsColumnNew}" FontSize="12" FontWeight="SemiBold"/>
                            </Grid>
                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Fields}" Margin="0,0,16,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="260,*,*" ColumnSpacing="16" Margin="0,5">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                           ToolTip.Tip="{Binding Help}"/>
                                                <SelectableTextBlock Grid.Column="1" Text="{Binding Current}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                                     IsVisible="{Binding !IsLocked}"/>
                                                <TextBox Grid.Column="2" Text="{Binding NewValue}" IsVisible="{Binding IsText}" TextWrapping="Wrap" ToolTip.Tip="{Binding Help}"
                                                         AcceptsReturn="False" VerticalAlignment="Center"
                                                         AutomationProperties.Name="{Binding Label}"/>
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding Choices}" SelectedItem="{Binding NewValue}"
                                                          IsVisible="{Binding ShowChoice}" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                          AutomationProperties.Name="{Binding Label}"/>
                                                <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding LockReason}" IsVisible="{Binding IsLocked}"
                                                           FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Classes="sunken" Padding="16" IsVisible="{Binding HasSummary}" MaxHeight="160">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <SelectableTextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="13"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource SurfaceSunkenBrush}"
                        CornerRadius="0,0,12,12" Padding="24,12" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <fi:SymbolIcon Symbol="Info" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{loc:Translate Key=EditSettingsFooter}" FontSize="12"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
