<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:local="clr-namespace:PhoneDesk.Views"
             xmlns:viewmodels="clr-namespace:PhoneDesk.ViewModels"
             xmlns:converters="clr-namespace:PhoneDesk.Converters"
             x:Class="PhoneDesk.Views.GetStartedView"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">
    <!-- DataContext is set via data binding from MainWindow -->

    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.setup-guidance">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,32">
        <StackPanel Margin="32" MaxWidth="850" HorizontalAlignment="Center" Spacing="24">

            <!-- Header Section -->
            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,16">
                <Border Classes="icon-badge">
                    <fi:SymbolIcon Symbol="Rocket"/>
                </Border>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Setup Steps"
                             Classes="page-title"
                             Margin="0"/>
                    <TextBlock Text="A short readiness check before you configure a customer. You can pause after any step and return later."
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <Border Classes="setup-guidance">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <fi:SymbolIcon Grid.Column="0"
                                   Symbol="Info"
                                   FontSize="22"
                                   Foreground="{DynamicResource TeamsPrimaryBrush}"
                                   VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="What happens here"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SetupGuidance}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SetupGuidanceDetail}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Command="{Binding NavigateToPageCommand}"
                            CommandParameter="Variables"
                            IsVisible="{Binding CanProceed}"
                            Classes="accent IconText"
                            VerticalAlignment="Center"
                            MinWidth="190">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Start configuration" VerticalAlignment="Center"/>
                            <fi:SymbolIcon Symbol="ArrowRight"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Step 1: PowerShell Modules -->
            <Border Classes="card interactive" AutomationProperties.Name="{Binding ModulesStatusText}">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="8">
                    <!-- Step Indicator -->
                    <Panel Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,24,0"
                           AutomationProperties.Name="{Binding ModulesStatusText}"
                           AutomationProperties.LiveSetting="Polite"
                           ToolTip.Tip="{Binding ModulesStatusText}">
                        <!-- Pending State: Ring with Number -->
                        <Border CornerRadius="16"
                                BorderBrush="{DynamicResource AccentHairlineBrush}"
                                BorderThickness="2"
                                IsVisible="{Binding !ModulesChecked}"
                                AutomationProperties.Name="Step 1: Pending"
                                ToolTip.Tip="Step 1: Pending">
                            <TextBlock Text="1" 
                                     FontSize="15"
                                     FontWeight="Bold"
                                     FontFamily="{StaticResource DisplayFontFamily}"
                                     Foreground="{DynamicResource TeamsPrimaryBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <!-- Completed State: Clean Icon -->
                        <fi:SymbolIcon Symbol="CheckmarkCircle" 
                                     FontSize="28"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                     IsVisible="{Binding ModulesChecked}"
                                     AutomationProperties.Name="Step 1: Completed"
                                     ToolTip.Tip="Step 1: Completed"/>
                    </Panel>
                    <!-- Content -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="Check PowerShell Modules"
                                 FontSize="18"
                                 FontWeight="SemiBold"/>
                        <TextBlock Text="Verify that Microsoft Teams and Microsoft Graph PowerShell modules are installed."
                                 FontSize="14"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                    <!-- Action -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="24,0,0,0">
                        <Button Command="{Binding CheckModulesCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                Classes="IconText"
                                MinWidth="160">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="BoxToolbox"/>
                                <TextBlock Text="{Binding ModulesActionText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Step 2: Teams Connection -->
            <Border Classes="card interactive" AutomationProperties.Name="{Binding TeamsStatusText}">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="8">
                    <!-- Step Indicator -->
                    <Panel Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,24,0"
                           AutomationProperties.Name="{Binding TeamsStatusText}"
                           AutomationProperties.LiveSetting="Polite"
                           ToolTip.Tip="{Binding TeamsStatusText}">
                        <Border CornerRadius="16"
                                BorderBrush="{DynamicResource AccentHairlineBrush}"
                                BorderThickness="2"
                                IsVisible="{Binding !TeamsConnected}"
                                AutomationProperties.Name="Step 2: Pending"
                                ToolTip.Tip="Step 2: Pending">
                            <TextBlock Text="2" 
                                     FontSize="15"
                                     FontWeight="Bold"
                                     FontFamily="{StaticResource DisplayFontFamily}"
                                     Foreground="{DynamicResource TeamsPrimaryBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <fi:SymbolIcon Symbol="CheckmarkCircle" 
                                     FontSize="28"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                     IsVisible="{Binding TeamsConnected}"
                                     AutomationProperties.Name="Step 2: Completed"
                                     ToolTip.Tip="Step 2: Completed"/>
                    </Panel>
                    <!-- Content -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="Connect to Microsoft Teams"
                                 FontSize="18"
                                 FontWeight="SemiBold"/>
                        <TextBlock Text="Establish a secure connection to your Microsoft Teams tenant. A sign-in window may appear."
                                 FontSize="14"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                    <!-- Action -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="24,0,0,0">
                        <Button Command="{Binding ConnectTeamsCommand}"
                                IsVisible="{Binding !TeamsConnected}"
                                IsEnabled="{Binding CanConnectTeams}"
                                Classes="IconText"
                                MinWidth="160">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="Person"/>
                                <TextBlock Text="{Binding TeamsActionText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DisconnectTeamsCommand}"
                                IsVisible="{Binding TeamsConnected}"
                                Classes="IconText"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                MinWidth="160">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="SignOut"/>
                                <TextBlock Text="Disconnect" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Step 3: Graph Connection -->
            <Border Classes="card interactive" AutomationProperties.Name="{Binding GraphStatusText}">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="8">
                    <!-- Step Indicator -->
                    <Panel Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,24,0"
                           AutomationProperties.Name="{Binding GraphStatusText}"
                           AutomationProperties.LiveSetting="Polite"
                           ToolTip.Tip="{Binding GraphStatusText}">
                        <Border CornerRadius="16"
                                BorderBrush="{DynamicResource AccentHairlineBrush}"
                                BorderThickness="2"
                                IsVisible="{Binding !GraphConnected}"
                                AutomationProperties.Name="Step 3: Pending"
                                ToolTip.Tip="Step 3: Pending">
                            <TextBlock Text="3" 
                                     FontSize="15"
                                     FontWeight="Bold"
                                     FontFamily="{StaticResource DisplayFontFamily}"
                                     Foreground="{DynamicResource TeamsPrimaryBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <fi:SymbolIcon Symbol="CheckmarkCircle" 
                                     FontSize="28"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                     IsVisible="{Binding GraphConnected}"
                                     AutomationProperties.Name="Step 3: Completed"
                                     ToolTip.Tip="Step 3: Completed"/>
                    </Panel>
                    <!-- Content -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="Connect to Microsoft Graph"
                                 FontSize="18"
                                 FontWeight="SemiBold"/>
                        <TextBlock Text="Connect to Microsoft Graph to manage groups and phone resources. A browser sign-in window will open."
                                 FontSize="14"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                    <!-- Action -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="24,0,0,0">
                         <Button Command="{Binding ConnectGraphCommand}"
                                IsVisible="{Binding !GraphConnected}"
                                IsEnabled="{Binding CanConnectGraph}"
                                Classes="IconText"
                                MinWidth="160">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="Cloud"/>
                                <TextBlock Text="{Binding GraphActionText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DisconnectGraphCommand}"
                                IsVisible="{Binding GraphConnected}"
                                Classes="IconText"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                MinWidth="160">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="SignOut"/>
                                <TextBlock Text="Disconnect" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Proceed Section -->
            <Border Classes="card"
                    Background="{DynamicResource SuccessSoftBrush}"
                    BorderBrush="{DynamicResource SuccessHairlineBrush}"
                    Margin="0,16,0,0"
                    IsVisible="{Binding CanProceed}">
                <Border.Styles>
                    <Style Selector="Border">
                        <Style.Animations>
                            <Animation Duration="0:0:0.3">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Border.Styles>
                <Grid ColumnDefinitions="*,Auto" Margin="8">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <fi:SymbolIcon Symbol="CheckmarkCircle" Foreground="{DynamicResource SystemFillColorSuccessBrush}" FontSize="24"/>
                            <TextBlock Text="All Systems Ready"
                                     FontSize="18"
                                     FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="You have successfully connected to all required services."
                                 FontSize="14"
                                 Opacity="0.7"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding NavigateToPageCommand}"
                            CommandParameter="Variables"
                            Classes="accent IconTextLarge"
                            FontWeight="Bold"
                            MinWidth="200">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Start Configuration" VerticalAlignment="Center"/>
                            <fi:SymbolIcon Symbol="ArrowRight"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Loading Indicator -->
             <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Spacing="12"
                        IsVisible="{Binding IsBusy}">
                <ProgressBar IsIndeterminate="True" Width="20" Height="20"/>
                <TextBlock Text="Processing..." Opacity="0.7"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
