<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:loc="clr-namespace:PhoneDesk.Localization"
             x:Class="PhoneDesk.Views.HealthCheckView"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="760">
    <Grid>
        <Border Classes="card" Margin="0">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Margin="24,24,24,16" Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Classes="icon-badge" VerticalAlignment="Top">
                            <fi:SymbolIcon Symbol="ShieldCheckmark"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Translate Key=HealthCheckTitle}" Classes="page-title" Margin="0"/>
                            <TextBlock Text="{loc:Translate Key=HealthCheckSubtitle}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <WrapPanel Orientation="Horizontal" IsEnabled="{Binding !IsBusy}">
                        <Button Command="{Binding RunHealthCheckCommand}" Classes="accent IconText" Margin="0,0,12,8">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="PulseSquare"/>
                                <TextBlock Text="{loc:Translate Key=HealthCheckRunAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenDashboardCommand}" Classes="IconText" Margin="0,0,12,8">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="DataTrending"/>
                                <TextBlock Text="{loc:Translate Key=HealthCheckOpenDashboardAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelOperationCommand}" Classes="IconText" Margin="0,0,12,8"
                                IsVisible="{Binding IsCancellable}">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="Dismiss"/>
                                <TextBlock Text="{loc:Translate Key=CommonCancel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding LastRunText}" Margin="4,8,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </WrapPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding IsBusy}">
                        <ProgressBar IsIndeterminate="True"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                               TextWrapping="Wrap"
                               IsVisible="{Binding !IsBusy}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="24,0,24,8" ColumnDefinitions="310,*" ColumnSpacing="16">
                    <Border Grid.Column="0" Classes="sunken" Padding="16">
                        <Grid RowDefinitions="Auto,*" RowSpacing="12">
                            <StackPanel Grid.Row="0" Spacing="4">
                                <TextBlock Text="{loc:Translate Key=HealthCheckRulesTitle}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Translate Key=HealthCheckRulesDescription}" TextWrapping="Wrap"
                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Rules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleSwitch IsChecked="{Binding IsEnabled}" Margin="0,0,0,10"
                                                          OnContent="{loc:Translate Key=CommonOn}"
                                                          OffContent="{loc:Translate Key=CommonOff}">
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxWidth="220"/>
                                            </ToggleSwitch>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Classes="sunken" Padding="16">
                        <ScrollViewer x:Name="HealthFindingsScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:Translate Key=HealthCheckFindingsTitle}" FontSize="18" FontWeight="SemiBold"/>

                                <Border Classes="card" Padding="24" IsVisible="{Binding ShowNoResultsState}">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                        <fi:SymbolIcon Symbol="PulseSquare" FontSize="30" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{loc:Translate Key=HealthCheckNoResultsTitle}"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{loc:Translate Key=HealthCheckNoResultsDescription}"
                                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="card" Padding="24" IsVisible="{Binding ShowHealthyState}">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                        <fi:SymbolIcon Symbol="ShieldCheckmark" FontSize="30" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource StatusOnBrush}"/>
                                        <TextBlock Text="{loc:Translate Key=HealthCheckHealthyTitle}"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{loc:Translate Key=HealthCheckHealthyDescription}"
                                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding ActiveFindings}" IsVisible="{Binding HasActiveFindings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="card" Padding="14" Margin="0,0,0,10">
                                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                        <Border Grid.Column="0" Classes="chip" IsVisible="{Binding IsError}">
                                                            <TextBlock Text="{Binding SeverityLabel}" Foreground="{DynamicResource HealthErrorBrush}"/>
                                                        </Border>
                                                        <Border Grid.Column="0" Classes="chip" IsVisible="{Binding IsWarning}">
                                                            <TextBlock Text="{Binding SeverityLabel}" Foreground="{DynamicResource HealthWarningBrush}"/>
                                                        </Border>
                                                        <Border Grid.Column="0" Classes="chip" IsVisible="{Binding IsInformation}">
                                                            <TextBlock Text="{Binding SeverityLabel}" Foreground="{DynamicResource TeamsPrimaryBrush}"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Text="{Binding RuleTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Finding.DisplayName}" FontSize="12" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16">
                                                        <StackPanel Grid.Column="0" Spacing="3">
                                                            <TextBlock Text="{loc:Translate Key=HealthCheckExplanationLabel}" FontSize="11" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="12"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="3">
                                                            <TextBlock Text="{loc:Translate Key=HealthCheckRecommendationLabel}" FontSize="11" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" FontSize="12"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <WrapPanel Grid.Row="2" Orientation="Horizontal">
                                                        <Button Command="{Binding DataContext.OpenFindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Classes="IconText" Margin="0,0,8,0"
                                                                IsVisible="{Binding CanOpen}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <fi:SymbolIcon Symbol="Open"/>
                                                                <TextBlock Text="{loc:Translate Key=HealthCheckOpenObjectAction}"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Command="{Binding DataContext.SuppressFindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Classes="IconText">
                                                            <StackPanel Orientation="Horizontal">
                                                                <fi:SymbolIcon Symbol="EyeOff"/>
                                                                <TextBlock Text="{loc:Translate Key=HealthCheckSuppressAction}"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </WrapPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ToggleSwitch IsChecked="{Binding ShowSuppressed}"
                                              IsVisible="{Binding HasSuppressedFindings}"
                                              OnContent="{loc:Translate Key=CommonShown}"
                                              OffContent="{loc:Translate Key=CommonHidden}"
                                              Content="{loc:Translate Key=HealthCheckShowSuppressed}"/>
                                <StackPanel Spacing="8" IsVisible="{Binding ShowSuppressed}">
                                    <TextBlock Text="{loc:Translate Key=HealthCheckSuppressedTitle}" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding SuppressedFindings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="card" Padding="12" Margin="0,0,0,8" Opacity="0.75">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding RuleTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Finding.DisplayName}" FontSize="12"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Command="{Binding DataContext.RestoreFindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Classes="IconText">
                                                            <TextBlock Text="{loc:Translate Key=HealthCheckRestoreAction}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource SurfaceSunkenBrush}"
                        CornerRadius="0,0,12,12" Padding="24,12" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <fi:SymbolIcon Symbol="Info" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{loc:Translate Key=HealthCheckReadOnlyFooter}" FontSize="12"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
