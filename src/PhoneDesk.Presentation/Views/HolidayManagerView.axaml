<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:loc="clr-namespace:PhoneDesk.Localization"
             xmlns:controls="clr-namespace:PhoneDesk.Controls"
             x:Class="PhoneDesk.Views.HolidayManagerView"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="760">
    <Grid>
        <Border Classes="card" Margin="0">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Margin="24,24,24,16" Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Classes="icon-badge" VerticalAlignment="Top">
                            <fi:SymbolIcon Symbol="CalendarEdit"/>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Translate Key=HolidayManagerTitle}" Classes="page-title" Margin="0"/>
                            <controls:InfoButton Name="PageHelp" HelpTitle="{loc:Translate Key=HolidayManagerTitle}" HelpText="{loc:Translate Key=HolidayManagerSubtitle}"/>
                        </StackPanel>
                    </Grid>

                    <WrapPanel Orientation="Horizontal" IsEnabled="{Binding !IsBusy}">
                        <Button Command="{Binding LoadCommand}" Classes="accent IconText" Margin="0,0,12,8">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="ArrowSync"/>
                                <TextBlock Text="{loc:Translate Key=HolidayManagerLoadAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelOperationCommand}" Classes="IconText" Margin="0,0,12,8"
                                IsVisible="{Binding IsCancellable}">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="Dismiss"/>
                                <TextBlock Text="{loc:Translate Key=CommonCancel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Border Grid.Row="1" Classes="sunken" Margin="24,0,24,8" Padding="24" IsVisible="{Binding ShowEmptyState}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <fi:SymbolIcon Symbol="CalendarEdit" FontSize="30" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{loc:Translate Key=HolidayManagerEmptyTitle}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Translate Key=HolidayManagerEmptyDescription}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="24,0,24,8" ColumnDefinitions="*,*" ColumnSpacing="16" IsVisible="{Binding IsLoaded}">
                    <Border Grid.Column="0" Classes="sunken" Padding="16">
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                            <TextBlock Grid.Row="0" Text="{loc:Translate Key=HolidayManagerSchedulesTitle}" FontSize="18" FontWeight="SemiBold"/>
                            <ListBox Grid.Row="1" x:Name="ScheduleList" ItemsSource="{Binding Schedules}" SelectedItem="{Binding SelectedSchedule}"
                                     Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="3" Margin="0,4">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <Border Grid.Column="1" Classes="chip" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}" FontSize="11"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Dates}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding UsedBy}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Grid.Row="2" Orientation="Horizontal" IsEnabled="{Binding !IsBusy}">
                                <Button Command="{Binding OpenEditDatesCommand}" Classes="IconText" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <fi:SymbolIcon Symbol="CalendarEdit"/>
                                        <TextBlock Text="{loc:Translate Key=HolidayManagerEditDatesAction}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenRetireCommand}" Classes="IconText">
                                    <StackPanel Orientation="Horizontal">
                                        <fi:SymbolIcon Symbol="Delete"/>
                                        <TextBlock Text="{loc:Translate Key=HolidayManagerRetireAction}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Classes="sunken" Padding="16">
                        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
                            <TextBlock Grid.Row="0" Text="{loc:Translate Key=HolidayManagerAttendantTitle}" FontSize="18" FontWeight="SemiBold"/>
                            <ComboBox Grid.Row="1" ItemsSource="{Binding AutoAttendants}" SelectedItem="{Binding SelectedAutoAttendant}"
                                      HorizontalAlignment="Stretch"/>
                            <TextBlock Grid.Row="2" Text="{Binding AttendantSummary}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ListBox Grid.Row="3" x:Name="HolidayList" ItemsSource="{Binding Holidays}" SelectedItem="{Binding SelectedHoliday}"
                                     Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="3" Margin="0,4">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock Text="{Binding ScheduleName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <Border Grid.Column="1" Classes="chip" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}" FontSize="11"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Dates}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding CallHandling}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Grid.Row="4" Orientation="Horizontal" IsEnabled="{Binding !IsBusy}">
                                <Button Command="{Binding OpenReplaceGreetingCommand}" Classes="IconText" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <fi:SymbolIcon Symbol="Speaker2"/>
                                        <TextBlock Text="{loc:Translate Key=HolidayManagerReplaceGreetingAction}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenAttachCommand}" Classes="IconText">
                                    <StackPanel Orientation="Horizontal">
                                        <fi:SymbolIcon Symbol="Copy"/>
                                        <TextBlock Text="{loc:Translate Key=HolidayManagerAttachAction}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource SurfaceSunkenBrush}"
                        CornerRadius="0,0,12,12" Padding="24,12" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <fi:SymbolIcon Symbol="Info" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{loc:Translate Key=HolidayManagerFooter}" FontSize="12"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- One dialog for the four changes: inputs, a check that sends nothing, then Apply. -->
        <Border IsVisible="{Binding ShowOperationDialog}" Background="#80000000" ZIndex="1000">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Classes="dialog" Width="760" MaxHeight="640" Margin="16">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                        <TextBlock Grid.Row="0" Text="{Binding OperationTitle}" Classes="dialog-title" TextWrapping="Wrap" Margin="0"/>
                        <ScrollViewer Grid.Row="1" x:Name="OperationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="12" Margin="0,0,12,0">
                                <StackPanel Spacing="4" IsVisible="{Binding IsEditDates}">
                                    <TextBlock Text="{loc:Translate Key=HolidayManagerDatesLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding OperationText}" AcceptsReturn="True" MinHeight="110" MaxHeight="180" TextWrapping="NoWrap"/>
                                    <TextBlock Text="{loc:Translate Key=HolidayManagerDatesHint}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Spacing="4" IsVisible="{Binding IsReplaceGreeting}">
                                    <TextBlock Text="{loc:Translate Key=HolidayManagerGreetingTextLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding OperationText}" AcceptsReturn="True" MinHeight="80" MaxHeight="140" TextWrapping="Wrap"/>
                                    <TextBlock Text="{loc:Translate Key=HolidayManagerGreetingAudioLabel}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBox Text="{Binding OperationSecondText}"/>
                                    <TextBlock Text="{loc:Translate Key=HolidayManagerGreetingHint}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Spacing="6" IsVisible="{Binding IsAttach}">
                                    <TextBlock Text="{loc:Translate Key=HolidayManagerTargetLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <ComboBox ItemsSource="{Binding TargetChoices}" SelectedItem="{Binding SelectedTarget}" HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="{loc:Translate Key=HolidayManagerAttendantsLabel}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <ItemsControl ItemsSource="{Binding AttendantChoices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}">
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <CheckBox IsChecked="{Binding ReplaceExpiredAtLimit}">
                                        <TextBlock Text="{loc:Translate Key=HolidayManagerReplaceExpiredOption}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding RemoveMissingUsers}">
                                        <TextBlock Text="{loc:Translate Key=HolidayManagerRemoveMissingUsersOption}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                </StackPanel>

                                <CheckBox IsChecked="{Binding AcceptOverlaps}" IsVisible="{Binding ShowOverlapOption}">
                                    <TextBlock Text="{loc:Translate Key=HolidayManagerAcceptOverlapsOption}" TextWrapping="Wrap"/>
                                </CheckBox>

                                <StackPanel Spacing="6" IsVisible="{Binding IsRetire}">
                                    <TextBlock Text="{loc:Translate Key=HolidayManagerRetireWarning}" TextWrapping="Wrap"/>
                                    <CheckBox IsChecked="{Binding AllowNotExpired}">
                                        <TextBlock Text="{loc:Translate Key=HolidayManagerAllowNotExpiredOption}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                </StackPanel>

                                <Border Classes="sunken" Padding="12" IsVisible="{Binding HasOperationPreview}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{loc:Translate Key=HolidayManagerPreviewTitle}" FontWeight="SemiBold"/>
                                        <SelectableTextBlock x:Name="OperationPreviewText" Text="{Binding OperationPreview}" TextWrapping="Wrap" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" IsEnabled="{Binding !IsBusy}">
                            <Button Command="{Binding CloseOperationCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Dismiss"/>
                                    <TextBlock Text="{loc:Translate Key=CommonCancel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CheckOperationCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Search"/>
                                    <TextBlock Text="{loc:Translate Key=HolidayManagerCheckAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ApplyOperationCommand}" Classes="accent IconText" IsEnabled="{Binding CanApplyOperation}">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Checkmark"/>
                                    <TextBlock Text="{loc:Translate Key=HolidayManagerApplyAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
