<UserControl xmlns="https://github.com/avaloniaui"
             x:Class="PhoneDesk.Views.HolidaysView"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:fic="using:FluentIcons.Common"
             xmlns:loc="clr-namespace:PhoneDesk.Localization"
             xmlns:local="clr-namespace:PhoneDesk.Views"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:viewmodels="clr-namespace:PhoneDesk.ViewModels"
             xmlns:converters="clr-namespace:PhoneDesk.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <!-- DataContext is set via data binding from MainWindow -->

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Local styles removed, using App.axaml styles -->
    </UserControl.Styles>

    <Grid>
    <Border Classes="card" Margin="0">
        <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Main Content -->
                <Grid Grid.Row="0" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Page Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Classes="icon-badge">
                        <fi:SymbolIcon Symbol="Calendar"/>
                    </Border>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Translate Key=MainNavigationHolidays}" Classes="page-title" Margin="0"/>
                        <TextBlock Text="{loc:Translate Key=HolidaysSubtitle}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
                    </StackPanel>

                    <!-- Status Message -->
                    <TextBlock Grid.Row="1" Text="{Binding StatusMessage}"
                             FontSize="13"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             TextWrapping="Wrap"
                             Margin="0,0,0,12"
                             IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <!-- Holiday Management Content -->
                    <ScrollViewer Grid.Row="2" Margin="0">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Key=HolidaysGuidedSetupIntro}"
                                     FontSize="18"
                                 FontWeight="SemiBold"
                                     Margin="0,0,0,24"/>

                            <!-- Step 1: Create Holiday -->
                            <Border Classes="card interactive" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate Key=HolidaysStep1Title}"
                                             FontSize="18"
                                             FontWeight="Bold"
                                             Margin="0,0,0,8"/>
                                    <TextBlock Text="{loc:Translate Key=HolidaysStep1Description}"
                                             FontSize="14"
                                             TextWrapping="Wrap"
                                             Margin="0,0,0,16"/>
                                    <Button
                                            Command="{Binding OpenCreateHolidayDialogCommand}"
                                            HorizontalAlignment="Left" Classes="IconText">
                                        <StackPanel Orientation="Horizontal">
                                            <fi:SymbolIcon  Symbol="CalendarAdd"/>
                                            <TextBlock Text="{loc:Translate Key=HolidaysCreateHolidayScheduleAction}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Step 2: Check Auto Attendant -->
                            <Border Classes="card interactive" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate Key=HolidaysStep2Title}"
                                             FontSize="18"
                                             FontWeight="Bold"
                                             Margin="0,0,0,8"/>
                                    <TextBlock Text="{loc:Translate Key=HolidaysStep2Description}"
                                             FontSize="14"
                                             TextWrapping="Wrap"
                                             Margin="0,0,0,16"/>
                                    <Button
                                            Command="{Binding OpenCheckAutoAttendantDialogCommand}"
                                            HorizontalAlignment="Left" Classes="IconText">
                                        <StackPanel Orientation="Horizontal">
                                            <fi:SymbolIcon  Symbol="CallCheckmark"/>
                                            <TextBlock Text="{loc:Translate Key=HolidaysCheckAutoAttendantAction}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Step 3: Attach Holiday to Auto Attendant -->
                            <Border Classes="card interactive" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate Key=HolidaysStep3Title}"
                                             FontSize="18"
                                             FontWeight="Bold"
                                             Margin="0,0,0,8"/>
                                    <TextBlock Text="{loc:Translate Key=HolidaysStep3Description}"
                                             FontSize="14"
                                             TextWrapping="Wrap"
                                             Margin="0,0,0,16"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                                Command="{Binding OpenAttachHolidayDialogCommand}"
                                                Margin="0,0,16,0" Classes="IconText">
                                            <StackPanel Orientation="Horizontal">
                                                <fi:SymbolIcon  Symbol="Link"/>
                                                <TextBlock Text="{loc:Translate Key=HolidaysLinkHolidayAction}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Progress Bar -->
                <ProgressBar Grid.Row="1"
                             IsIndeterminate="{Binding IsBusy}"
                             IsVisible="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Height="4"
                             Margin="0,0,0,4"/>
            </Grid>
        </Border>

        <!-- Create Holiday Dialog - Border overlay -->
        <Border IsVisible="{Binding ShowCreateHolidayDialog}"
                Background="#80000000"
                ZIndex="1000"
                PointerPressed="CreateHolidayBackdrop_PointerPressed">
            <Border.Styles>
                <Style Selector="Border">
                    <Style.Animations>
                        <Animation Duration="0:0:0.2">
                            <KeyFrame Cue="0%">
                                <Setter Property="Opacity" Value="0"/>
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="Opacity" Value="1"/>
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Border.Styles>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                  PointerPressed="CreateHolidayCard_PointerPressed">
                <Border Classes="dialog" MinWidth="400" Margin="16">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Key=HolidaysCreateDialogTitle}"
                                 Classes="dialog-title"/>
                        <TextBlock Text="{loc:Translate Key=HolidaysConfigurationLabel}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,8"/>
                        <TextBlock Text="{loc:Translate Key=HolidaysCreateDialogDescription}"
                                 FontSize="14"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Right"
                                  Spacing="16">
                            <Button Command="{Binding CloseCreateHolidayDialogCommand}"
                                    Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Dismiss"/>
                                    <TextBlock Text="{loc:Translate Key=CommonCancel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                    Command="{Binding CreateHolidayCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon  Symbol="CalendarAdd"/>
                                    <TextBlock Text="{loc:Translate Key=HolidaysCreateHolidayScheduleAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Check Auto Attendant Dialog - Border overlay -->
        <Border IsVisible="{Binding ShowCheckAutoAttendantDialog}"
                Background="#80000000"
                ZIndex="1000"
                PointerPressed="CheckAutoAttendantBackdrop_PointerPressed">
            <Border.Styles>
                <Style Selector="Border">
                    <Style.Animations>
                        <Animation Duration="0:0:0.2">
                            <KeyFrame Cue="0%">
                                <Setter Property="Opacity" Value="0"/>
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="Opacity" Value="1"/>
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Border.Styles>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                  PointerPressed="CheckAutoAttendantCard_PointerPressed">
                <Border Classes="dialog" MinWidth="400" Margin="16">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Key=HolidaysCheckDialogTitle}"
                                 Classes="dialog-title"/>
                        <TextBlock Text="{loc:Translate Key=CommonAutoAttendantNameLabel}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,8"/>
                        <TextBox Text="{Binding AutoAttendantName}"
                                 Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Translate Key=HolidaysCheckDialogDescription}"
                                 FontSize="12"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Right"
                                  Spacing="16">
                            <Button Command="{Binding CloseCheckAutoAttendantDialogCommand}"
                                    Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Dismiss"/>
                                    <TextBlock Text="{loc:Translate Key=CommonCancel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                    Command="{Binding VerifyAutoAttendantCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon  Symbol="Checkmark"/>
                                    <TextBlock Text="{loc:Translate Key=HolidaysVerifyAndConfirmAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Attach Holiday to Auto Attendant Dialog - Border overlay -->
        <Border IsVisible="{Binding ShowAttachHolidayDialog}"
                Background="#80000000"
                ZIndex="1000"
                PointerPressed="AttachHolidayBackdrop_PointerPressed">
            <Border.Styles>
                <Style Selector="Border">
                    <Style.Animations>
                        <Animation Duration="0:0:0.2">
                            <KeyFrame Cue="0%">
                                <Setter Property="Opacity" Value="0"/>
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="Opacity" Value="1"/>
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Border.Styles>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                  PointerPressed="AttachHolidayCard_PointerPressed">
                <Border Classes="dialog" MinWidth="400" Margin="16">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Key=HolidaysLinkDialogTitle}"
                                 Classes="dialog-title"/>
                        <TextBlock Text="{loc:Translate Key=CommonHolidayNameLabel}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,8"/>
                        <TextBox Text="{Binding HolidayName}"
                                 Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Translate Key=CommonAutoAttendantNameLabel}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,8"/>
                        <TextBox Text="{Binding AutoAttendantName}"
                                 Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Translate Key=HolidaysLinkDialogDescription}"
                                 FontSize="12"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Right"
                                  Spacing="16">
                            <Button Command="{Binding CloseAttachHolidayDialogCommand}"
                                    Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Dismiss"/>
                                    <TextBlock Text="{loc:Translate Key=CommonCancel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button
                                    Command="{Binding AttachHolidayToAutoAttendantCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon  Symbol="Link"/>
                                    <TextBlock Text="{loc:Translate Key=HolidaysLinkHolidayAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Progress Indicator -->
        <Grid
              Opacity="0.8"
              IsVisible="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="360">
                <ProgressBar
                       Minimum="0"
                       Maximum="100"
                       Value="{Binding ProgressValue}"
                       IsIndeterminate="{Binding IsProgressIndeterminate}"
                       Width="200"/>
                <!-- Waiting Message -->
                <TextBlock Text="{Binding WaitingMessage, TargetNullValue={x:Static sys:String.Empty}}"
                           FontSize="14"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                <!-- Native PowerShell progress detail -->
                <TextBlock Text="{Binding ProgressText}"
                           IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                <!-- Cancel affordance -->
                <Button Content="{loc:Translate Key=CommonCancel}"
                        Command="{Binding CancelOperationCommand}"
                        IsVisible="{Binding IsCancellable}"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl> 
