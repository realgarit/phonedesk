<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:fic="using:FluentIcons.Common"
             xmlns:loc="clr-namespace:PhoneDesk.Localization"
             xmlns:local="clr-namespace:PhoneDesk.Views"
             xmlns:viewmodels="clr-namespace:PhoneDesk.ViewModels"
             xmlns:converters="clr-namespace:PhoneDesk.Converters"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="PhoneDesk.Views.M365GroupsView"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <!-- DataContext is set via data binding from MainWindow -->

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Ellipsis-trim long values in list grids so rows stay distinguishable and the
             rightmost column's text can never disappear under the vertical scrollbar. -->
        <Style Selector="DataGridCell TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="card" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Main Content -->
            <Grid Grid.Row="0" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Page Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                    <Border Classes="icon-badge">
                        <fi:SymbolIcon Symbol="People"/>
                    </Border>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Translate Key=MainNavigationM365Groups}" Classes="page-title" Margin="0"/>
                        <TextBlock Text="{loc:Translate Key=M365GroupsSubtitle}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
                </StackPanel>

                <!-- Group Status -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <ui:InfoBar Title="{Binding GroupStatus}"
                               IsOpen="{Binding GroupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               IsClosable="True"
                               Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                IsVisible="{Binding IsGroupChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{loc:Translate Key=M365GroupsGroupIdLabel}"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding GroupId}"
                                   FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action + Search -->
                <Grid Grid.Row="2" Margin="0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding RetrieveM365GroupsCommand}"
                            Margin="0,0,16,0" Classes="IconText">
                        <StackPanel Orientation="Horizontal">
                            <fi:SymbolIcon  Symbol="ArrowSync"/>
                            <TextBlock Text="{loc:Translate Key=M365GroupsLoadGroupsAction}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1"
                            Command="{Binding OpenCreateGroupDialogCommand}"
                            Margin="0,0,16,0" Classes="IconText">
                        <StackPanel Orientation="Horizontal">
                            <fi:SymbolIcon  Symbol="Add"/>
                            <TextBlock Text="{loc:Translate Key=M365GroupsCreateGroupAction}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Command="{Binding RemoveM365GroupCommand}"
                            Margin="0,0,16,0" Classes="IconText">
                        <StackPanel Orientation="Horizontal">
                            <fi:SymbolIcon Symbol="Delete" Foreground="OrangeRed"/>
                            <TextBlock Text="{loc:Translate Key=M365GroupsDeleteGroupAction}" Foreground="OrangeRed" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBox Grid.Column="3"
                             Text="{Binding SearchText}"
                             Watermark="{loc:Translate Key=M365GroupsSearchWatermark}"
                             ToolTip.Tip="{loc:Translate Key=M365GroupsSearchTooltip}"
                             AutomationProperties.Name="{loc:Translate Key=M365GroupsSearchAutomationName}"/>
                </Grid>

                <!-- Groups List -->
                <Grid Grid.Row="3" Margin="0,16">
                    <DataGrid AutomationProperties.Name="{loc:Translate Key=M365GroupsGridAutomationName}"
                              ItemsSource="{Binding GroupsView}"
                              SelectedItem="{Binding SelectedGroup}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              GridLinesVisibility="None"
                              SelectionMode="Single"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Translate Key=M365GroupsDisplayNameColumn}" Binding="{Binding DisplayName}" Width="2*"/>
                            <DataGridTextColumn Header="{loc:Translate Key=M365GroupsMailNicknameColumn}" Binding="{Binding MailNickname}" Width="*"/>
                            <DataGridTextColumn Header="{loc:Translate Key=M365GroupsDescriptionColumn}" Binding="{Binding Description}" Width="2*"/>
                            <DataGridTextColumn Header="{loc:Translate Key=CommonIdColumn}" Binding="{Binding Id}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding !GroupsView.Count}"
                                Opacity="0.85" Spacing="10">
                        <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                                        <fi:SymbolIcon Symbol="People" IsFilled="True" FontSize="26" Foreground="{DynamicResource TeamsPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                                    </Border>
                        <TextBlock Text="{loc:Translate Key=M365GroupsEmptyTitle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Translate Key=M365GroupsEmptyDescription}" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

            </Grid>

            <!-- Confirmation Dialog -->
            <!-- Confirm Variables Dialog - Border overlay -->
            <Border IsVisible="{Binding ShowConfirmation}"
                    Background="#80000000"
                    ZIndex="1000"
                    PointerPressed="ConfirmVariablesBackdrop_PointerPressed">
                <Border.Styles>
                    <Style Selector="Border">
                        <Style.Animations>
                            <Animation Duration="0:0:0.2">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Border.Styles>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      PointerPressed="ConfirmVariablesCard_PointerPressed">
                    <Border Classes="dialog" Margin="16">
                        <StackPanel>
                        <TextBlock Text="{loc:Translate Key=M365GroupsConfirmConfigurationTitle}"
                                 Classes="dialog-title"/>
                        <TextBlock Text="{loc:Translate Key=M365GroupsConfirmConfigurationDescription}"
                                 FontSize="14"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal"
                                  HorizontalAlignment="Right"
                                  Spacing="8">
                            <Button Command="{Binding NavigateToVariablesPageCommand}"
                                     Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon  Symbol="Code"/>
                                    <TextBlock Text="{loc:Translate Key=M365GroupsGoToConfigurationAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CheckM365GroupCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon  Symbol="Checkmark"/>
                                    <TextBlock Text="{loc:Translate Key=CommonContinue}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Create Group Dialog - Border overlay -->
            <Border IsVisible="{Binding ShowCreateGroupDialog}"
                    Background="#80000000"
                    ZIndex="1000"
                    PointerPressed="CreateGroupBackdrop_PointerPressed">
                <Border.Styles>
                    <Style Selector="Border">
                        <Style.Animations>
                            <Animation Duration="0:0:0.2">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Border.Styles>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                      PointerPressed="CreateGroupCard_PointerPressed">
                    <Border Classes="dialog" MinWidth="400" Margin="16">
                        <StackPanel>
                        <TextBlock Text="{loc:Translate Key=M365GroupsCreateDialogTitle}"
                                 Classes="dialog-title"/>
                        <TextBlock Text="{loc:Translate Key=M365GroupsGroupNameLabel}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,8"/>
                        <TextBox Text="{Binding NewGroupName}"
                               Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Translate Key=M365GroupsDescriptionOptionalLabel}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,8"/>
                        <TextBox Text="{Binding NewGroupDescription}"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               Height="60"
                               VerticalContentAlignment="Top"
                               Margin="0,0,0,16"/>
                        <TextBlock Text="{loc:Translate Key=M365GroupsAutoGeneratedHint}"
                                 FontSize="12"
                                 Opacity="0.7"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Right"
                                  Spacing="16">
                            <Button Command="{Binding CloseCreateGroupDialogCommand}"
                                    Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon Symbol="Dismiss"/>
                                    <TextBlock Text="{loc:Translate Key=CommonCancel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CreateNewGroupCommand}" Classes="IconText">
                                <StackPanel Orientation="Horizontal">
                                    <fi:SymbolIcon  Symbol="Add"/>
                                    <TextBlock Text="{loc:Translate Key=M365GroupsCreateDialogConfirmAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Progress Indicator -->
            <Grid
                  Opacity="0.8"
                  IsVisible="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="360">
                    <ProgressBar Minimum="0"
                               Maximum="100"
                               Value="{Binding ProgressValue}"
                               IsIndeterminate="{Binding IsProgressIndeterminate}"
                               Width="200"/>
                    <!-- Native PowerShell progress detail -->
                    <TextBlock Text="{Binding ProgressText}"
                               IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                    <!-- Cancel affordance -->
                    <Button Content="{loc:Translate Key=CommonCancel}"
                            Command="{Binding CancelOperationCommand}"
                            IsVisible="{Binding IsCancellable}"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
