<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:loc="clr-namespace:PhoneDesk.Localization"
             xmlns:controls="clr-namespace:PhoneDesk.Controls"
             x:Class="PhoneDesk.Views.SetupRunsView"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="760">
    <Grid>
        <Border Classes="card" Margin="0">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Margin="24,24,24,16" Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Classes="icon-badge" VerticalAlignment="Top">
                            <fi:SymbolIcon Symbol="ArrowUndo"/>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Translate Key=SetupRunsTitle}" Classes="page-title" Margin="0"/>
                            <controls:InfoButton Name="PageHelp" HelpTitle="{loc:Translate Key=SetupRunsTitle}" HelpText="{loc:Translate Key=SetupRunsSubtitle}"/>
                        </StackPanel>
                    </Grid>

                    <WrapPanel Orientation="Horizontal" IsEnabled="{Binding !IsBusy}">
                        <Button Command="{Binding RefreshCommand}" Classes="IconText" Margin="0,0,12,8">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="ArrowSync"/>
                                <TextBlock Text="{loc:Translate Key=SetupRunsRefreshAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CheckRollbackCommand}" Classes="accent IconText" Margin="0,0,12,8" IsEnabled="{Binding HasRuns}">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="Search"/>
                                <TextBlock Text="{loc:Translate Key=SetupRunsCheckAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RollBackCommand}" Classes="IconText" Margin="0,0,12,8" IsEnabled="{Binding CanRollBack}">
                            <StackPanel Orientation="Horizontal">
                                <fi:SymbolIcon Symbol="ArrowUndo"/>
                                <TextBlock Text="{loc:Translate Key=SetupRunsRollbackAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Border Grid.Row="1" Classes="sunken" Margin="24,0,24,8" Padding="24" IsVisible="{Binding ShowEmptyState}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <fi:SymbolIcon Symbol="ArrowUndo" FontSize="30" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{loc:Translate Key=SetupRunsEmptyTitle}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Translate Key=SetupRunsEmptyDescription}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="24,0,24,8" RowDefinitions="*,*" RowSpacing="8" IsVisible="{Binding HasRuns}">
                    <Border Grid.Row="0" Classes="sunken" Padding="16">
                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                            <Grid Grid.Row="0" ColumnDefinitions="150,*,170,150,90" ColumnSpacing="12" Margin="12,4,12,0">
                                <TextBlock Grid.Column="0" Text="{loc:Translate Key=SetupRunsColumnStarted}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{loc:Translate Key=SetupRunsColumnRun}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{loc:Translate Key=SetupRunsColumnKind}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="3" Text="{loc:Translate Key=SetupRunsColumnState}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="4" Text="{loc:Translate Key=SetupRunsColumnObjects}" FontSize="12" FontWeight="SemiBold"/>
                            </Grid>
                            <ListBox Grid.Row="1" x:Name="RunList" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}"
                                     Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="150,*,170,150,90" ColumnSpacing="12">
                                            <TextBlock Grid.Column="0" Text="{Binding Started}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Kind}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="{Binding State}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Objects}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Classes="sunken" Padding="16" IsVisible="{Binding HasDetails}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <SelectableTextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="13"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource SurfaceSunkenBrush}"
                        CornerRadius="0,0,12,12" Padding="24,12" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <fi:SymbolIcon Symbol="Info" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{loc:Translate Key=SetupRunsFooter}" FontSize="12"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
