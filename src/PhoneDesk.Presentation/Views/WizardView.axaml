<UserControl xmlns="https://github.com/avaloniaui"
             x:Class="PhoneDesk.Views.WizardView"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:fic="using:FluentIcons.Common"
             xmlns:loc="clr-namespace:PhoneDesk.Localization"
             xmlns:local="clr-namespace:PhoneDesk.Views"
             xmlns:viewmodels="clr-namespace:PhoneDesk.ViewModels"
             xmlns:converters="clr-namespace:PhoneDesk.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.wizard-guidance">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="Button.wizard-step">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.wizard-step.current /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHairlineBrush}"/>
        </Style>
        <Style Selector="Button.wizard-step:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.wizard-step:disabled">
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
        <Style Selector="Border.wizard-guidance Button.validation-details">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Border Classes="card" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Step Sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceSunkenBrush}"
                        BorderBrush="{DynamicResource HairlineBrush}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="12,0,0,12"
                        Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="16,20,16,12">
                            <TextBlock Text="{loc:Translate Key=WizardSidebarTitle}"
                                     FontFamily="{StaticResource DisplayFontFamily}"
                                     FontSize="17"
                                     FontWeight="SemiBold"
                                     Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Translate Key=WizardSidebarSubtitle}"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     TextWrapping="Wrap"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding Steps}" Margin="8,0,8,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Completed, skipped and failed steps open on click; later steps stay locked. -->
                                        <Button Classes="wizard-step"
                                                Classes.current="{Binding IsCurrent}"
                                                IsEnabled="{Binding IsReachable}"
                                                Command="{Binding $parent[ItemsControl].DataContext.GoToStepCommand}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Title}">
                                            <Grid ColumnDefinitions="24,*">
                                                <TextBlock Grid.Column="0"
                                                         Text="{Binding StatusIcon}"
                                                         FontSize="14"
                                                         VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="{Binding Title}"
                                                             FontSize="12"
                                                             FontWeight="SemiBold"
                                                             TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Grid.Row="2"
                                Margin="16,4,16,16"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding StartOverCommand}"
                                    AutomationProperties.Name="{loc:Translate Key=WizardStartOverAction}"
                                IsVisible="{Binding HasProgress}"
                                IsEnabled="{Binding !IsBusy}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fi:SymbolIcon Symbol="ArrowCounterclockwise" FontSize="14"/>
                                <TextBlock Text="{loc:Translate Key=WizardStartOverAction}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Main Content Area -->
                <Grid Grid.Column="1" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <!-- The script/review area keeps a usable height; the result area below is capped. -->
                        <RowDefinition Height="*" MinHeight="150"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Step Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <!-- Grid instead of a horizontal StackPanel so long (German) step titles wrap. -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="16"
                                    Width="32" Height="32"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding StepNumberBadgeText}"
                                         Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                         FontWeight="Bold"
                                         FontSize="14"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{Binding StepNumberText}"
                                         FontSize="11"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding StepTitle}"
                                         FontFamily="{StaticResource DisplayFontFamily}"
                                         FontSize="21"
                                         FontWeight="SemiBold"
                                         LetterSpacing="-0.2"
                                         TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding StepDescription}"
                                 FontSize="14"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 Margin="44,4,0,0"
                                 TextWrapping="Wrap"/>
                        <!-- An earlier run that did not finish: resume it or roll it back. -->
                        <Border IsVisible="{Binding HasPendingRun}" Classes="sunken" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                <fi:SymbolIcon Grid.Column="0" Symbol="History" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding PendingRunText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Command="{Binding ResumePendingRunCommand}" Content="{loc:Translate Key=WizardResumeRunAction}" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Command="{Binding OpenSetupRunsCommand}" Content="{loc:Translate Key=SetupRunsOpenAction}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Progress Bar -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <ProgressBar Minimum="0"
                                     Maximum="{Binding TotalSteps}"
                                     Value="{Binding WizardProgressValue}"
                                     Height="4"/>
                    </Grid>

                    <!-- Script Preview / Dry-Run Plan Content -->
                    <Border Grid.Row="2"
                            Classes="sunken"
                            ClipToBounds="True"
                            Margin="0,0,0,12">
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0"
                                    Classes="wizard-guidance"
                                    Margin="12,10,12,0">
                                <Grid RowDefinitions="Auto,Auto"
                                      ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="10"
                                      RowSpacing="0">
                                    <fi:SymbolIcon Grid.Column="0"
                                                   Grid.RowSpan="2"
                                                   Symbol="Info"
                                                   FontSize="20"
                                                   Foreground="{DynamicResource TeamsPrimaryBrush}"
                                                   VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding ReadinessMessage}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ValidationIssueSummary}"
                                                   IsVisible="{Binding HasValidationIssues}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ConfigurationChangedNotice}"
                                                   IsVisible="{Binding HasConfigurationChangedNotice}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource HealthWarningBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Button Grid.Row="0"
                                            Grid.Column="2"
                                            Classes="validation-details"
                                            IsVisible="{Binding HasValidationIssues}"
                                            Command="{Binding ToggleValidationDetailsCommand}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding ValidationDetailsAction}"/>
                                    </Button>

                                    <Border Grid.Row="1"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Classes="sunken"
                                            Margin="0,7,0,0"
                                            Padding="8"
                                            MaxHeight="116"
                                            IsVisible="{Binding IsValidationDetailsExpanded}">
                                        <ScrollViewer MaxHeight="98"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ValidationIssues}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,1"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <!-- Human-readable configuration review. -->
                                <Grid IsVisible="{Binding Plan, Converter={x:Static ObjectConverters.IsNull}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  IsVisible="{Binding IsReviewStep}"
                                                  Padding="16">
                                        <StackPanel Spacing="14">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <fi:SymbolIcon Symbol="Settings"
                                                               Foreground="{DynamicResource TeamsPrimaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                <TextBlock Text="{loc:Translate Key=WizardReviewSnapshotTitle}"
                                                           FontWeight="SemiBold"
                                                           FontSize="15"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ReviewSummary}"
                                                       TextWrapping="Wrap"
                                                       FontSize="13"/>
                                            <TextBlock Text="{loc:Translate Key=WizardReviewSnapshotHint}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- PowerShell script preview for provisioning steps. -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto"
                                                  IsVisible="{Binding IsReviewStep, Converter={StaticResource InverseBooleanConverter}}">
                                        <TextBox Text="{Binding StepScript}"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="NoWrap"
                                                 FontFamily="{StaticResource CodeFontFamily}"
                                                 FontSize="12"
                                                 BorderThickness="0"
                                                 Padding="16"
                                                 Watermark="{loc:Translate Key=WizardScriptPreviewWatermark}"/>
                                    </ScrollViewer>
                                </Grid>

                                <!-- Dry-run plan (shown once generated; closes when the step changes). -->
                                <Grid RowDefinitions="Auto,*"
                                      IsVisible="{Binding Plan, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Button Grid.Row="0"
                                        HorizontalAlignment="Right"
                                        Margin="0,8,12,0"
                                        Command="{Binding ClosePlanCommand}"
                                    AutomationProperties.Name="{loc:Translate Key=WizardClosePlanAction}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fi:SymbolIcon Symbol="Dismiss" FontSize="14"/>
                                        <TextBlock Text="{loc:Translate Key=WizardClosePlanAction}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              Padding="16">
                                    <ItemsControl ItemsSource="{Binding Plan.Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <Panel Grid.Column="0" VerticalAlignment="Top" Margin="0,1,8,0">
                                                            <fi:SymbolIcon Symbol="CheckmarkCircle" Foreground="Green" IsVisible="{Binding IsValid}"/>
                                                            <fi:SymbolIcon Symbol="ErrorCircle" Foreground="OrangeRed" IsVisible="{Binding !IsValid}"/>
                                                        </Panel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding ValidationErrors}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" Foreground="OrangeRed" FontSize="12" TextWrapping="Wrap"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl ItemsSource="{Binding PreflightChecks}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnDefinitions="Auto,*" Margin="8,1,0,1">
                                                                    <Panel Grid.Column="0" VerticalAlignment="Top" Margin="0,1,8,0">
                                                                        <fi:SymbolIcon Symbol="Checkmark" FontSize="12" Foreground="Green" IsVisible="{Binding IsPass}"/>
                                                                        <fi:SymbolIcon Symbol="Warning" FontSize="12" Foreground="Orange" IsVisible="{Binding IsWarning}"/>
                                                                        <fi:SymbolIcon Symbol="ErrorCircle" FontSize="12" Foreground="OrangeRed" IsVisible="{Binding IsFail}"/>
                                                                        <fi:SymbolIcon Symbol="Question" FontSize="12" IsVisible="{Binding IsNotChecked}"/>
                                                                    </Panel>
                                                                    <TextBlock Grid.Column="1" FontSize="11"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                                        <Run Text="{loc:Translate Key=BulkOperationsPreflightLabel}"/>
                                                                        <Run Text="{Binding Detail}"/>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl ItemsSource="{Binding Objects}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnDefinitions="Auto,*" Margin="8,2,0,2">
                                                                    <fi:SymbolIcon Grid.Column="0" Symbol="ChevronRight" FontSize="12"
                                                                                   VerticalAlignment="Top" Margin="0,2,8,0"/>
                                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                                        <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding Upn}" FontSize="12"
                                                                                   TextWrapping="Wrap"
                                                                                   IsVisible="{Binding Upn, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Step Result: a short error first (when the step failed), then the raw output. -->
                    <StackPanel Grid.Row="3" Spacing="8" Margin="0,0,0,12"
                                IsVisible="{Binding StepResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Border IsVisible="{Binding HasStepError}"
                                BorderBrush="{DynamicResource HealthErrorBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <fi:SymbolIcon Grid.Column="0"
                                               Symbol="ErrorCircle"
                                               FontSize="18"
                                               Foreground="{DynamicResource HealthErrorBrush}"
                                               VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{loc:Translate Key=WizardStepErrorTitle}"
                                               FontWeight="SemiBold"/>
                                    <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto">
                                        <SelectableTextBlock Text="{Binding StepErrorMessage}"
                                                             TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="sunken"
                                Padding="12"
                                MaxHeight="120">
                            <ScrollViewer>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{loc:Translate Key=WizardStepOutputTitle}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <SelectableTextBlock Text="{Binding StepResult}"
                                                         FontSize="12"
                                                         FontFamily="{StaticResource CodeFontFamily}"
                                                         TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.Styles>
                            <!-- Restore the inter-button gap lost when the centre group became a WrapPanel. -->
                            <Style Selector="WrapPanel#WizardActionButtons > Button">
                                <Setter Property="Margin" Value="4"/>
                            </Style>
                        </Grid.Styles>

                        <!-- Left: Back -->
                        <Button Grid.Column="0"
                                VerticalAlignment="Center"
                                Command="{Binding GoToPreviousStepCommand}"
                                    AutomationProperties.Name="{loc:Translate Key=CommonBack}"
                                IsEnabled="{Binding CanGoPrevious}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fi:SymbolIcon Symbol="ArrowLeft" FontSize="14"/>
                                <TextBlock Text="{loc:Translate Key=CommonBack}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Center: Execute / Skip / Retry — wraps to multiple rows when the width is tight
                             instead of overflowing under the Back/Next buttons. -->
                        <WrapPanel Grid.Column="1"
                                   x:Name="WizardActionButtons"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <!-- Execute Step -->
                            <Button Command="{Binding ExecuteCurrentStepCommand}"
                                    AutomationProperties.Name="{Binding ExecuteButtonText}"
                                    Classes="accent"
                                    IsEnabled="{Binding CanExecuteStep}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="Play" FontSize="14"/>
                                    <TextBlock Text="{Binding ExecuteButtonText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Skip -->
                            <Button Command="{Binding SkipStepCommand}"
                                    AutomationProperties.Name="{loc:Translate Key=CommonSkip}"
                                    IsEnabled="{Binding !IsBusy}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="Next" FontSize="14"/>
                                    <TextBlock Text="{loc:Translate Key=CommonSkip}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Dry-run plan preview + export -->
                            <Button Command="{Binding GeneratePlanCommand}"
                                    AutomationProperties.Name="{loc:Translate Key=WizardPreviewChangesAction}"
                                    IsEnabled="{Binding !IsBusy}"
                                    ToolTip.Tip="{loc:Translate Key=WizardPreviewChangesTooltip}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="ClipboardTaskListLtr" FontSize="14"/>
                                    <TextBlock Text="{loc:Translate Key=WizardPreviewChangesAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CheckPlanAgainstTenantCommand}"
                                    AutomationProperties.Name="{loc:Translate Key=PlanTenantCheckAction}"
                                    IsEnabled="{Binding !IsBusy}"
                                    ToolTip.Tip="{loc:Translate Key=PlanTenantCheckTooltip}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="CloudCheckmark" FontSize="14"/>
                                    <TextBlock Text="{loc:Translate Key=PlanTenantCheckAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ExportPlanJsonCommand}"
                                    AutomationProperties.Name="{loc:Translate Key=WizardExportPlanJsonTooltip}"
                                    IsEnabled="{Binding !IsBusy}"
                                    ToolTip.Tip="{loc:Translate Key=WizardExportPlanJsonTooltip}">
                                <fi:SymbolIcon Symbol="Code" FontSize="14"/>
                            </Button>
                            <Button Command="{Binding ExportPlanCsvCommand}"
                                    AutomationProperties.Name="{loc:Translate Key=WizardExportPlanCsvTooltip}"
                                    IsEnabled="{Binding !IsBusy}"
                                    ToolTip.Tip="{loc:Translate Key=WizardExportPlanCsvTooltip}">
                                <fi:SymbolIcon Symbol="DocumentTable" FontSize="14"/>
                            </Button>
                            <!-- Retry after a failure, or run a completed step again -->
                            <Button Command="{Binding RetryStepCommand}"
                                    AutomationProperties.Name="{Binding RetryActionText}"
                                    IsVisible="{Binding ShowRetryAction}"
                                    IsEnabled="{Binding !IsBusy}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="ArrowSync" FontSize="14"/>
                                    <TextBlock Text="{Binding RetryActionText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- After a failure: remove what this run created -->
                            <Button Command="{Binding OpenSetupRunsCommand}"
                                    AutomationProperties.Name="{loc:Translate Key=WizardRollbackRunAction}"
                                    IsVisible="{Binding ShowRollbackAction}"
                                    IsEnabled="{Binding !IsBusy}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="ArrowUndo" FontSize="14"/>
                                    <TextBlock Text="{loc:Translate Key=WizardRollbackRunAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Navigate to Variables (step 0 only) -->
                            <Button Command="{Binding GoToVariablesPageCommand}"
                                    AutomationProperties.Name="{loc:Translate Key=WizardEditConfigurationAction}"
                                    IsVisible="{Binding IsReviewStep}"
                                    Tag="edit_variables">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fi:SymbolIcon Symbol="Edit" FontSize="14"/>
                                    <TextBlock Text="{loc:Translate Key=WizardEditConfigurationAction}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- Right: Next -->
                        <Button Grid.Column="2"
                                VerticalAlignment="Center"
                                Command="{Binding GoToNextStepCommand}"
                                    AutomationProperties.Name="{loc:Translate Key=CommonNext}"
                                IsEnabled="{Binding CanGoNext}"
                                Classes="accent">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{loc:Translate Key=CommonNext}" VerticalAlignment="Center"/>
                                <fi:SymbolIcon Symbol="ArrowRight" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Busy Overlay -->
        <Border IsVisible="{Binding IsBusy}"
                Background="#80000000"
                CornerRadius="8">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        MaxWidth="360">
                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressValue}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Width="200"/>
                <TextBlock Text="{Binding StatusMessage}"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         HorizontalAlignment="Center"/>
                <!-- Native PowerShell progress detail -->
                <TextBlock Text="{Binding ProgressText}"
                           IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>
                <!-- Cancel affordance -->
                <Button Content="{loc:Translate Key=CommonCancel}"
                        Command="{Binding CancelOperationCommand}"
                        IsVisible="{Binding IsCancellable}"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
